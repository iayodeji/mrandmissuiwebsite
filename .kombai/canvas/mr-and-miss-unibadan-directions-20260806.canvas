2-16\" data-name=\"barcode element\">\n                            </i>\n                            <i data-kid=\"1-2-7-2-2-3-2-17\" data-name=\"barcode element\">\n                            </i>\n                            <i data-kid=\"1-2-7-2-2-3-2-18\" data-name=\"barcode element\">\n                            </i>\n                            <i data-kid=\"1-2-7-2-2-3-2-19\" data-name=\"barcode element\">\n                            </i>\n                            <i data-kid=\"1-2-7-2-2-3-2-20\" data-name=\"barcode element\">\n                            </i>\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"footer\" data-kid=\"1-3\" data-name=\"footer section\">\n        <div data-kid=\"1-3-1\" data-name=\"footer brand container\">\n            <span class=\"footer-mark\" data-kid=\"1-3-1-1\" data-name=\"footer brand name\">\n                M&M / UI\n            </span>\n            <p data-kid=\"1-3-1-2\" data-name=\"footer brand description\">\n                Where the brilliant find their balance, and the balanced find their crown.\n            </p>\n        </div>\n        <div data-kid=\"1-3-2\" data-name=\"footer sponsor container\">\n            <span class=\"mono eyebrow\" data-kid=\"1-3-2-1\" data-name=\"sponsor label\">\n                PROUDLY SPONSORED BY\n            </span>\n            <p data-kid=\"1-3-2-2\" data-name=\"sponsor info\">\n                Kioskk / Inioluwa Ayodeji\n                <br data-kid=\"1-3-2-2-1\" data-name=\"sponsor info line break\">\n                Kioskk.me\n            </p>\n        </div>\n        <div data-kid=\"1-3-3\" data-name=\"footer note container\">\n            <span class=\"mono eyebrow\" data-kid=\"1-3-3-1\" data-name=\"note label\">\n                PROGRAMME NOTE\n            </span>\n            <p data-kid=\"1-3-3-2\" data-name=\"copyright notice\">\n                Elegance. Balan