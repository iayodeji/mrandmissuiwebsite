      },
      "html": "<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n\n  :root {\n    --midnight: #090d16;\n    --ink: #f3f5f7;\n    --muted: #9ca6b4;\n    --line: rgba(243, 245, 247, 0.16);\n    --line-strong: rgba(243, 245, 247, 0.32);\n    --surface: #101722;\n    --surface-2: #151d29;\n    --blue: #3f73ff;\n    --blue-soft: rgba(63, 115, 255, 0.14);\n    --silver: #c8d1dc;\n  }\n\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    background: var(--midnight);\n    color: var(--ink);\n    font-family: 'Space Grotesk', Arial, sans-serif;\n    -webkit-font-smoothing: antialiased;\n  }\n  button, a, summary { font: inherit; }\n  a { color: inherit; text-decoration: none; }\n  button { color: inherit; }\n  img { display: block; max-width: 100%; }\n  ::selection { color: var(--midnight); background: var(--blue); }\n  :focus-visible { outline: 2px solid var(--blue); outline-offset: 4px; }\n\n  .programme {\n    min-width: 0;\n    background-color: var(--midnight);\n    background-image:\n      linear-gradient(to right, transparent 0, transparent calc(25% - 0.5px), var(--line) 25%, transparent calc(25% + 0.5px), transparent calc(50% - 0.5px), var(--line) 50%, transparent calc(50% + 0.5px), transparent calc(75% - 0.5px), var(--line) 75%, transparent calc(75% + 0.5px));\n  }\n  .mono {\n    font-family: 'DM Mono', monospace;\n    font-size: 10px;\n    line-height: 1.4;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n  }\n  .eyebrow { color: var(--muted); }\n  .blue { color: var(--blue); }\n\n  .topbar {\n    position: sticky;\n    top: 0;\n    z-index: 20;\n    display: grid;\n    grid-template-columns: 1.4fr 1fr 1fr auto;\n    min-height: 58px;\n    border-bottom: 1px solid var(--line-strong);\n    background: rgba(9, 13, 22, 0.96);\n  }\n  .topbar > * {\n    display: flex;\n    align-items: center;\n    min-height: 58px;\n    padding: 0 20px;\n    border-right: 1px solid var(--line);\n  }\n  .brand-lockup { gap: 14px; }\n  .brand-mark {\n    display: grid;\n    place-items: center;\n    width: 26px;\n    height: 26px;\n    border: 1px solid var(--blue);\n    color: var(--blue);\n    font-size: 11px;\n    font-weight: 700;\n  }\n  .brand-name { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; }\n  .topbar .nav-item { color: var(--muted); transition: color 180ms ease, background 180ms ease; }\n  .topbar .nav-item:hover { color: var(--ink); background: var(--surface-2); }\n  .menu-button {\n    justify-content: center;\n    width: 76px;\n    padding: 0 14px;\n    border: 0;\n    background: var(--blue);\n    color: var(--midnight);\n    cursor: pointer;\n    font-weight: 700;\n  }\n  .menu-button:hover { background: var(--ink); }\n\n  .ticker {\n    display: flex;\n    justify-content: space-between;\n    gap: 24px;\n    padding: 11px 20px;\n    border-bottom: 1px solid var(--line);\n    color: var(--muted);\n    white-space: nowrap;\n    overflow: hidden;\n  }\n  .ticker strong { color: var(--ink); font-weight: 500; }\n  .ticker .ticker-right { color: var(--blue); }\n\n  .hero {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n    min-height: 630px;\n    border-bottom: 1px solid var(--line-strong);\n  }\n  .hero-copy {\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    padding: 48px 38px 30px 20px;\n    border-right: 1px solid var(--line-strong);\n  }\n  .hero-kicker { display: flex; justify-content: space-between; align-items: center; color: var(--muted); }\n  .hero-kicker .signal { display: inline-flex; align-items: center; gap: 8px; color: var(--blue); }\n  .signal-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--blue); }\n  .hero-title {\n    max-width: 590px;\n    margin: auto 0 40px;\n    font-size: clamp(68px, 8vw, 122px);\n    line-height: 0.88;\n    letter-spacing: -0.085em;\n    font-weight: 600;\n  }\n  .hero-title span { display: block; }\n  .hero-title .outline { color: transparent; -webkit-text-stroke: 1px var(--silver); }\n  .hero-foot {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 20px;\n    padding-top: 18px;\n    border-top: 1px solid var(--line);\n  }\n  .hero-foot p { margin: 0; max-width: 220px; color: var(--muted); font-size: 13px; line-height: 1.55; }\n  .hero-foot .action { color: var(--ink); text-align: right; }\n  .hero-foot .action span { display: block; margin-top: 7px; color: var(--blue); font-size: 19px; }\n  .hero-media { position: relative; min-height: 630px; overflow: hidden; background: #171d27; }\n  .hero-media img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.08) brightness(0.76); }\n  .hero-media::after { content: ''; position: absolute; inset: 0; background: rgba(9, 13, 22, 0.18); pointer-events: none; }\n  .media-label { position: absolute; left: 20px; right: 20px; bottom: 20px; z-index: 1; display: flex; justify-content: space-between; align-items: end; }\n  .media-label .caption { max-width: 210px; color: var(--ink); font-size: 12px; line-height: 1.4; }\n  .media-label .index { color: var(--blue); font-size: 24px; }\n\n  .section { border-bottom: 1px solid var(--line-strong); }\n  .section-head {\n    display: flex;\n    justify-content: space-between;\n    align-items: baseline;\n    gap: 24px;\n    padding: 18px 20px;\n    border-bottom: 1px solid var(--line);\n  }\n  .section-head h2 { margin: 0; font-size: 14px; font-weight: 500; letter-spacing: -0.02em; }\n  .section-head .section-index { color: var(--blue); }\n  .section-head .section-note { color: var(--muted); }\n\n  .intro-grid {\n    display: grid;\n    grid-template-columns: 1.35fr 0.65fr 1fr;\n    min-height: 420px;\n  }\n  .intro-story { padding: 42px 40px 42px 20px; border-right: 1px solid var(--line); }\n  .intro-story .dropcap { float: left; margin: -8px 14px 0 0; color: var(--blue); font-size: 92px; line-height: 0.84; font-weight: 600; }\n  .intro-story p { max-width: 530px; margin: 0; font-size: 25px; line-height: 1.27; letter-spacing: -0.045em; }\n  .intro-story .small-copy { margin-top: 30px; color: var(--muted); font-size: 14px; line-height: 1.55; letter-spacing: 0; }\n  .intro-quote { display: flex; flex-direction: column; justify-content: space-between; padding: 42px 24px; border-right: 1px solid var(--line); background: var(--surface); }\n  .quote-mark { color: var(--blue); font-size: 40px; line-height: 1; }\n  .intro-quote blockquote { margin: 0; font-size: 27px; line-height: 1.08; letter-spacing: -0.05em; }\n  .intro-quote cite { color: var(--muted); font-style: normal; }\n  .stat-rail { display: grid; grid-template-rows: repeat(3, 1fr); }\n  .stat-row { display: grid; grid-template-columns: 70px 1fr; align-items: center; gap: 18px; padding: 18px 20px; border-bottom: 1px solid var(--line); }\n  .stat-row:last-child { border-bottom: 0; }\n  .stat-value { font-size: 44px; line-height: 1; letter-spacing: -0.08em; }\n  .stat-label { color: var(--muted); font-size: 12px; line-height: 1.3; }\n  .stat-label strong { display: block; margin-bottom: 4px; color: var(--ink); font-size: 14px; font-weight: 500; }\n\n  .purpose-grid { display: grid; grid-template-columns: 0.7fr 1.3fr; min-height: 520px; }\n  .purpose-aside { padding: 42px 20px; border-right: 1px solid var(--line); }\n  .purpose-aside h3 { max-width: 220px; margin: 0; font-size: 64px; line-height: 0.9; letter-spacing: -0.08em; font-weight: 500; }\n  .purpose-aside p { max-width: 200px; margin: 44px 0 0; color: var(--muted); font-size: 13px; line-height: 1.5; }\n  .purpose-content { padding: 22px 20px 30px; }\n  .tab-controls { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--line-strong); }\n  .tab-controls input { position: absolute; width: 1px; height: 1px; opacity: 0.01; }\n  .tab-controls label { padding: 17px 18px; color: var(--muted); cursor: pointer; font-family: 'DM Mono', monospace; font-size: 11px; letter-spacing: 0.12em; }\n  .tab-controls label + label { border-left: 1px solid var(--line-strong); }\n  #vision-tab:checked ~ .tab-controls label[for='vision-tab'], #mission-tab:checked ~ .tab-controls label[for='mission-tab'] { color: var(--ink); background: var(--blue-soft); }\n  .purpose-panels { margin-top: 1px; border: 1px solid var(--line); border-top: 0; }\n  .purpose-panel { display: none; padding: 36px 38px 30px; }\n  #vision-tab:checked ~ .purpose-panels .vision-panel, #mission-tab:checked ~ .purpose-panels .mission-panel { display: block; }\n  .purpose-panel h4 { margin: 0 0 20px; font-size: 46px; line-height: 0.95; letter-spacing: -0.07em; font-weight: 500; }\n  .purpose-panel > p { max-width: 690px; margin: 0 0 38px; color: var(--silver); font-size: 20px; line-height: 1.45; letter-spacing: -0.03em; }\n  .index-list { display: grid; grid-template-columns: 1fr 1fr; gap: 0 32px; border-top: 1px solid var(--line); }\n  .index-item { display: grid; grid-template-columns: 40px 1fr; gap: 14px; padding: 17px 0; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 13px; line-height: 1.45; }\n  .index-item .num { color: var(--blue); font-family: 'DM Mono', monospace; font-size: 11px; }\n\n  .crown-section { background: var(--surface); }\n  .crown-intro { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 40px; padding: 34px 20px; border-bottom: 1px solid var(--line); }\n  .crown-intro h3 { margin: 0; max-width: 590px; font-size: 58px; line-height: 0.92; letter-spacing: -0.08em; font-weight: 500; }\n  .crown-intro p { max-width: 330px; margin: 4px 0 0 auto; color: var(--muted); font-size: 14px; line-height: 1.55; }\n  .portrait-matrix { display: grid; grid-template-columns: repeat(6, 1fr); gap: 1px; background: var(--line); }\n  .portrait { position: relative; min-height: 260px; overflow: hidden; background: var(--midnight); }\n  .portrait:nth-child(2), .portrait:nth-child(5) { min-height: 330px; }\n  .portrait img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.07) brightness(0.7); transition: transform 300ms ease, filter 300ms ease; }\n  .portrait:hover img, .portrait.active img { filter: grayscale(0) contrast(1.05) brightness(0.9); transform: scale(1.035); }\n  .portrait.active { box-shadow: inset 0 0 0 2px var(--blue); }\n  .portrait-tag { position: absolute; left: 12px; right: 12px; bottom: 12px; display: flex; justify-content: space-between; gap: 10px; padding-top: 10px; border-top: 1px solid rgba(243,245,247,0.48); color: var(--ink); font-family: 'DM Mono', monospace; font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; }\n  .portrait-tag span:last-child { color: var(--blue); }\n  .crown-footer { display: flex; justify-content: space-between; padding: 18px 20px; color: var(--muted); }\n\n  .lineage-list { border-top: 0; }\n  .lineage-row { border-bottom: 1px solid var(--line); }\n  .lineage-row summary { display: grid; grid-template-columns: 70px 1.3fr 0.8fr 0.7fr 30px; align-items: center; gap: 16px; padding: 20px; cursor: pointer; list-style: none; }\n  .lineage-row summary::-webkit-details-marker { display: none; }\n  .lineage-row summary:hover { background: var(--surface-2); }\n  .lineage-row[open] summary { background: var(--blue-soft); }\n  .lineage-no { color: var(--blue); }\n  .lineage-name { font-size: 23px; letter-spacing: -0.04em; }\n  .lineage-field, .lineage-year { color: var(--muted); font-size: 13px; }\n  .lineage-chevron { justify-self: end; color: var(--blue); font-size: 22px; transition: transform 200ms ease; }\n  .lineage-row[open] .lineage-chevron { transform: rotate(45deg); }\n  .lineage-reveal { display: grid; grid-template-columns: 70px 1fr 1fr; gap: 16px; padding: 0 20px 24px 90px; background: var(--surface-2); }\n  .lineage-reveal img { width: 100%; height: 180px; object-fit: cover; filter: grayscale(1) contrast(1.08); }\n  .lineage-reveal-copy { display: flex; flex-direction: column; justify-content: end; padding-bottom: 4px; }\n  .lineage-reveal-copy p { max-width: 380px; margin: 0 0 12px; color: var(--silver); font-size: 16px; line-height: 1.45; }\n\n  .night { background: var(--midnight); }\n  .ticket-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--line); }\n  .ticket-info { padding: 42px 32px 48px 20px; background: var(--surface); }\n  .ticket-info h3 { max-width: 520px; margin: 24px 0 48px; font-size: 74px; line-height: 0.9; letter-spacing: -0.09em; font-weight: 500; }\n  .ticket-info h3 em { color: var(--blue); font-style: normal; }\n  .ticket-meta { border-top: 1px solid var(--line-strong); }\n  .ticket-meta-row { display: grid; grid-template-columns: 100px 1fr; gap: 20px; padding: 15px 0; border-bottom: 1px solid var(--line); }\n  .ticket-meta-row .value { color: var(--silver); font-size: 16px; }\n  .ticket-actions { display: flex; align-items: center; gap: 16px; margin-top: 36px; }\n  .rsvp { display: inline-flex; align-items: center; gap: 18px; padding: 15px 18px; border: 0; background: var(--blue); color: var(--midnight); cursor: pointer; font-weight: 700; }\n  .rsvp:hover { background: var(--ink); }\n  .ticket-note { max-width: 200px; color: var(--muted); font-size: 11px; line-height: 1.4; }\n  .ticket-art { position: relative; display: flex; flex-direction: column; justify-content: space-between; min-height: 560px; padding: 22px; background: #dce1e7; color: var(--midnight); overflow: hidden; }\n  .ticket-art img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.1) brightness(0.75); mix-blend-mode: multiply; opacity: 0.9; }\n  .ticket-art::after { content: ''; position: absolute; inset: 0; background: rgba(220,225,231,0.12); }\n  .ticket-art > * { position: relative; z-index: 1; }\n  .ticket-art .ticket-top, .ticket-art .ticket-bottom { display: flex; justify-content: space-between; gap: 16px; }\n  .barcode { display: flex; align-items: stretch; gap: 3px; width: 180px; height: 48px; }\n  .barcode i { display: block; width: 2px; background: var(--midnight); }\n  .barcode i:nth-child(2n) { width: 5px; }\n  .barcode i:nth-child(3n) { width: 1px; }\n  .ticket-art .large-number { font-size: 54px; line-height: 0.9; letter-spacing: -0.08em; }\n\n  .footer { display: grid; grid-template-columns: 1.4fr 1fr 1fr; border-top: 1px solid var(--line-strong); }\n  .footer > div { min-height: 110px; padding: 20px; border-right: 1px solid var(--line); }\n  .footer p { margin: 12px 0 0; color: var(--muted); font-size: 12px; line-height: 1.45; }\n  .footer .footer-mark { color: var(--blue); font-size: 26px; font-weight: 600; }\n\n  @media (max-width: 820px) {\n    .programme { background-image: none; }\n    .topbar { grid-template-columns: 1fr auto; }\n    .topbar .nav-item { display: none; }\n    .hero, .purpose-grid, .ticket-wrap { grid-template-columns: 1fr; }\n    .hero-copy { min-height: 540px; border-right: 0; border-bottom: 1px solid var(--line-strong); }\n    .hero-media { min-height: 480px; }\n    .intro-grid { grid-template-columns: 1fr 1fr; }\n    .intro-story { grid-column: 1 / -1; border-right: 0; border-bottom: 1px solid var(--line); }\n    .intro-quote { border-right: 1px solid var(--line); }\n    .portrait-matrix { grid-template-columns: repeat(3, 1fr); }\n    .portrait { min-height: 260px; }\n    .crown-intro { grid-template-columns: 1fr; gap: 20px; }\n    .crown-intro p { margin: 0; }\n    .purpose-aside { border-right: 0; border-bottom: 1px solid var(--line); }\n    .purpose-aside h3 { max-width: none; }\n    .purpose-aside p { margin-top: 24px; }\n    .ticket-art { min-height: 420px; }\n    .footer { grid-template-columns: 1fr 1fr; }\n    .footer > div:first-child { grid-column: 1 / -1; }\n  }\n  @media (max-width: 560px) {\n    .ticker { padding-inline: 14px; }\n    .hero-copy { padding: 28px 16px 22px; }\n    .hero-title { font-size: clamp(60px, 17vw, 92px); }\n    .hero-foot { grid-template-columns: 1fr; }\n    .hero-foot .action { text-align: left; }\n    .section-head, .intro-story, .intro-quote, .purpose-aside, .purpose-content, .crown-intro, .crown-footer, .ticket-info, .footer > div { padding-left: 16px; padding-right: 16px; }\n    .intro-grid { grid-template-columns: 1fr; }\n    .intro-quote { border-right: 0; border-bottom: 1px solid var(--line); min-height: 260px; }\n    .stat-row { grid-template-columns: 55px 1fr; padding-inline: 16px; }\n    .purpose-panel { padding: 28px 20px; }\n    .purpose-panel h4 { font-size: 38px; }\n    .purpose-panel > p { font-size: 17px; }\n    .index-list { grid-template-columns: 1fr; }\n    .portrait-matrix { grid-template-columns: repeat(2, 1fr); }\n    .portrait:nth-child(2), .portrait:nth-child(5) { min-height: 260px; }\n    .lineage-row summary { grid-template-columns: 34px 1fr 30px; gap: 8px; padding-inline: 16px; }\n    .lineage-field, .lineage-year { display: none; }\n    .lineage-reveal { grid-template-columns: 1fr; padding: 0 16px 20px; }\n    .lineage-reveal img { height: 230px; }\n    .ticket-info h3 { font-size: 58px; margin: 22px 0 34px; }\n    .ticket-meta-row { grid-template-columns: 82px 1fr; }\n    .ticket-actions { align-items: flex-start; flex-direction: column; }\n    .footer { grid-template-columns: 1fr; }\n    .footer > div:first-child { grid-column: auto; }\n    .footer > div { border-right: 0; border-bottom: 1px solid var(--line); }\n  }\n</style>\n<div class=\"programme\" data-kid=\"1\" data-name=\"page layout container\">\n    <header aria-label=\"Primary navigation\" class=\"topbar\" data-kid=\"1-1\" data-name=\"main navigation bar\">\n        <a aria-label=\"Mr and Miss Unibadan home\" class=\"brand-lockup\" data-kid=\"1-1-1\" data-name=\"brand lockup link\" href=\"#top\">\n            <span class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"brand mark\">\n                M&U\n            </span>\n            <span class=\"brand-name\" data-kid=\"1-1-1-2\" data-name=\"brand name\">\n                MR & MISS UNIBADAN\n            </span>\n        </a>\n        <a class=\"nav-item mono\" data-kid=\"1-1-2\" data-name=\"navigation link\" href=\"#story\">\n            01 / STORY\n        </a>\n        <a class=\"nav-item mono\" data-kid=\"1-1-3\" data-name=\"navigation link\" href=\"#crown\">\n            02 / CROWN\n        </a>\n        <a class=\"nav-item mono\" data-kid=\"1-1-4\" data-name=\"navigation link\" href=\"#night\">\n            03 / NIGHT\n        </a>\n        <button aria-label=\"Open programme menu\" class=\"menu-button mono\" data-kid=\"1-1-5\" data-name=\"menu button\" type=\"button\">\n            MENU\n        </button>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main content area\" id=\"top\">\n        <div aria-label=\"Event details\" class=\"ticker mono\" data-kid=\"1-2-1\" data-name=\"event details ticker\">\n            <span data-kid=\"1-2-1-1\" data-name=\"event info container\">\n                <strong data-kid=\"1-2-1-1-1\" data-name=\"event name\">\n                    UNIVERSITY OF IBADAN\n                </strong>\n                / 2026 EDITION\n            </span>\n            <span class=\"ticker-right\" data-kid=\"1-2-1-2\" data-name=\"ticker highlight\">\n                15 YEARS OF CRYSTAL EXCELLENCE\n            </span>\n            <span data-kid=\"1-2-1-3\" data-name=\"instruction text\">\n                SCROLL TO EXPLORE ↓\n            </span>\n        </div>\n        <section aria-labelledby=\"hero-title\" class=\"hero\" data-kid=\"1-2-2\" data-name=\"hero section\">\n            <div class=\"hero-copy\" data-kid=\"1-2-2-1\" data-name=\"hero copy container\">\n                <div class=\"hero-kicker mono\" data-kid=\"1-2-2-1-1\" data-name=\"hero kicker container\">\n                    <span data-kid=\"1-2-2-1-1-1\" data-name=\"program label\">\n                        PROGRAMME / 00\n                    </span>\n                    <span class=\"signal\" data-kid=\"1-2-2-1-1-2\" data-name=\"signal indicator container\">\n                        <i class=\"signal-dot\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"signal dot\">\n                        </i>\n                        LIVE EDITION\n                    </span>\n                </div>\n                <h1 class=\"hero-title\" data-kid=\"1-2-2-1-2\" data-name=\"hero headline\" id=\"hero-title\">\n                    <span data-kid=\"1-2-2-1-2-1\" data-name=\"hero title part 1\">\n                        MR &\n                    </span>\n                    <span data-kid=\"1-2-2-1-2-2\" data-name=\"hero title part 2\">\n                        MISS\n                    </span>\n                    <span class=\"outline\" data-kid=\"1-2-2-1-2-3\" data-name=\"hero title outline text\">\n                        UNIBADAN\n                    </span>\n                </h1>\n                <div class=\"hero-foot\" data-kid=\"1-2-2-1-3\" data-name=\"hero footer\">\n                    <p data-kid=\"1-2-2-1-3-1\" data-name=\"hero description text\">\n                        Where brilliance meets grace. A living record of presence, purpose, and the people who carry the crown forward.\n                    </p>\n                    <a class=\"action mono\" data-kid=\"1-2-2-1-3-2\" data-name=\"primary action link\" href=\"#night\">\n                        ENTER THE PROGRAMME\n                        <span data-kid=\"1-2-2-1-3-2-1\" data-name=\"arrow icon\">\n                            ↘\n                        </span>\n                    </a>\n                </div>\n            </div>\n            <div class=\"hero-media\" data-kid=\"1-2-2-2\" data-name=\"hero media container\">\n                <img alt=\"University of Ibadan pageantry event backdrop\" data-kid=\"1-2-2-2-1\" data-name=\"hero media image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/image0.jpeg\">\n                <div class=\"media-label\" data-kid=\"1-2-2-2-2\" data-name=\"media label container\">\n                    <span class=\"caption mono\" data-kid=\"1-2-2-2-2-1\" data-name=\"media caption text\">\n                        THE CALLING\n                        <br data-kid=\"1-2-2-2-2-1-1\" data-name=\"caption line break\">\n                        A STUDY IN PRESENCE\n                    </span>\n                    <span class=\"index mono\" data-kid=\"1-2-2-2-2-2\" data-name=\"media index text\">\n                        01—06\n                    </span>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"story-title\" class=\"section\" data-kid=\"1-2-3\" data-name=\"story section\" id=\"story\">\n            <div class=\"section-head mono\" data-kid=\"1-2-3-1\" data-name=\"story section header\">\n                <h2 data-kid=\"1-2-3-1-1\" data-name=\"story section title\" id=\"story-title\">\n                    <span class=\"section-index\" data-kid=\"1-2-3-1-1-1\" data-name=\"section index number\">\n                        01\n                    </span>\n                    / THE STORY\n                </h2>\n                <span class=\"section-note\" data-kid=\"1-2-3-1-2\" data-name=\"section note text\">\n                    ORIGIN / PURPOSE / IMPACT\n                </span>\n            </div>\n            <div class=\"intro-grid\" data-kid=\"1-2-3-2\" data-name=\"intro grid container\">\n                <div class=\"intro-story\" data-kid=\"1-2-3-2-1\" data-name=\"intro story container\">\n                    <p data-kid=\"1-2-3-2-1-1\" data-name=\"story paragraph\">\n                        <span class=\"dropcap\" data-kid=\"1-2-3-2-1-1-1\" data-name=\"dropcap character\">\n                            F\n                        </span>\n                        or over 15 years, Mr. & Mrs. UI has stood as one of the most prestigious and culturally celebrated pageantry platforms within the University of Ibadan community.\n                    </p>\n                    <p class=\"small-copy\" data-kid=\"1-2-3-2-1-2\" data-name=\"story small copy\">\n                        More than a beauty pageant, it is a platform dedicated to discovering and showcasing students who embody excellence, confidence, intelligence, creativity, leadership, and social influence.\n                    </p>\n                </div>\n                <aside class=\"intro-quote\" data-kid=\"1-2-3-2-2\" data-name=\"intro quote section\">\n                    <span class=\"quote-mark\" data-kid=\"1-2-3-2-2-1\" data-name=\"quote mark icon\">\n                        “\n                    </span>\n                    <blockquote data-kid=\"1-2-3-2-2-2\" data-name=\"quote blockquote\">\n                        The crown is not a finish line. It is a public promise.\n                    </blockquote>\n                    <cite class=\"mono\" data-kid=\"1-2-3-2-2-3\" data-name=\"quote citation\">\n                        / THE STANDARD\n                    </cite>\n                </aside>\n                <div aria-label=\"Programme statistics\" class=\"stat-rail\" data-kid=\"1-2-3-2-3\" data-name=\"programme statistics rail\">\n                    <div class=\"stat-row\" data-kid=\"1-2-3-2-3-1\" data-name=\"stat row\">\n                        <span class=\"stat-value blue\" data-kid=\"1-2-3-2-3-1-1\" data-name=\"stat value\">\n                            01\n                        </span>\n                        <span class=\"stat-label\" data-kid=\"1-2-3-2-3-1-2\" data-name=\"stat label\">\n                            <strong data-kid=\"1-2-3-2-3-1-2-1\" data-name=\"stat label bold\">\n                                University\n                            </strong>\n                            One community, many stories.\n                        </span>\n                    </div>\n                    <div class=\"stat-row\" data-kid=\"1-2-3-2-3-2\" data-name=\"stat row\">\n                        <span class=\"stat-value blue\" data-kid=\"1-2-3-2-3-2-1\" data-name=\"stat value\">\n                            03\n                        </span>\n                        <span class=\"stat-label\" data-kid=\"1-2-3-2-3-2-2\" data-name=\"stat label\">\n                            <strong data-kid=\"1-2-3-2-3-2-2-1\" data-name=\"stat label bold\">\n                                Crowns\n                            </strong>\n                            Three visible marks of excellence.\n                        </span>\n                    </div>\n                    <div class=\"stat-row\" data-kid=\"1-2-3-2-3-3\" data-name=\"stat row\">\n                        <span class=\"stat-value blue\" data-kid=\"1-2-3-2-3-3-1\" data-name=\"stat value\">\n                            15\n                        </span>\n                        <span class=\"stat-label\" data-kid=\"1-2-3-2-3-3-2\" data-name=\"stat label\">\n                            <strong data-kid=\"1-2-3-2-3-3-2-1\" data-name=\"stat label bold\">\n                                Years\n                            </strong>\n                            A legacy still in motion.\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"purpose-title\" class=\"section\" data-kid=\"1-2-4\" data-name=\"journey section\">\n            <div class=\"section-head mono\" data-kid=\"1-2-4-1\" data-name=\"journey section header\">\n                <h2 data-kid=\"1-2-4-1-1\" data-name=\"journey section title\" id=\"purpose-title\">\n                    <span class=\"section-index\" data-kid=\"1-2-4-1-1-1\" data-name=\"section index number\">\n                        02\n                    </span>\n                    / THE JOURNEY\n                </h2>\n                <span class=\"section-note\" data-kid=\"1-2-4-1-2\" data-name=\"section note text\">\n                    VISION + MISSION\n                </span>\n            </div>\n            <div class=\"purpose-grid\" data-kid=\"1-2-4-2\" data-name=\"purpose grid container\">\n                <aside class=\"purpose-aside\" data-kid=\"1-2-4-2-1\" data-name=\"purpose aside container\">\n                    <h3 data-kid=\"1-2-4-2-1-1\" data-name=\"purpose title\">\n                        OUR\n                        <br data-kid=\"1-2-4-2-1-1-1\" data-name=\"title line break\">\n                        <span class=\"blue\" data-kid=\"1-2-4-2-1-1-2\" data-name=\"blue emphasis text\">\n                            PURPOSE\n                        </span>\n                    </h3>\n                    <p class=\"mono\" data-kid=\"1-2-4-2-1-2\" data-name=\"purpose subtitle\">\n                        A platform is measured by what it makes possible after the applause.\n                    </p>\n                </aside>\n                <div class=\"purpose-content\" data-kid=\"1-2-4-2-2\" data-name=\"purpose content container\">\n                    <input checked=\"\" data-kid=\"1-2-4-2-2-1\" data-name=\"vision tab radio input\" id=\"vision-tab\" name=\"purpose-tabs\" type=\"radio\">\n                    <input data-kid=\"1-2-4-2-2-2\" data-name=\"mission tab radio input\" id=\"mission-tab\" name=\"purpose-tabs\" type=\"radio\">\n                    <div aria-label=\"Vision and mission\" class=\"tab-controls\" data-kid=\"1-2-4-2-2-3\" data-name=\"tab controls list\" role=\"tablist\">\n                        <label data-kid=\"1-2-4-2-2-3-1\" data-name=\"vision tab label\" for=\"vision-tab\" role=\"tab\">\n                            [01] VISION\n                        </label>\n                        <label data-kid=\"1-2-4-2-2-3-2\" data-name=\"mission tab label\" for=\"mission-tab\" role=\"tab\">\n                            [02] MISSION\n                        </label>\n                    </div>\n                    <div class=\"purpose-panels\" data-kid=\"1-2-4-2-2-4\" data-name=\"purpose panels container\">\n                        <article class=\"purpose-panel vision-panel\" data-kid=\"1-2-4-2-2-4-1\" data-name=\"vision panel\" role=\"tabpanel\">\n                            <h4 data-kid=\"1-2-4-2-2-4-1-1\" data-name=\"vision panel title\">\n                                Build a platform that lasts.\n                            </h4>\n                            <p data-kid=\"1-2-4-2-2-4-1-2\" data-name=\"vision panel body text\">\n                                To build a prestigious platform that empowers students to become symbols of excellence, leadership, creativity, and positive influence within the university community and beyond.\n                            </p>\n                            <div class=\"index-list\" data-kid=\"1-2-4-2-2-4-1-3\" data-name=\"vision index list\">\n                                <div class=\"index-item\" data-kid=\"1-2-4-2-2-4-1-3-1\" data-name=\"index item\">\n                                    <span class=\"num\" data-kid=\"1-2-4-2-2-4-1-3-1-1\" data-name=\"index item number\">\n                                        [01]\n                                    </span>\n                                    <span data-kid=\"1-2-4-2-2-4-1-3-1-2\" data-name=\"index item text\">\n                                        Make confidence visible and purposeful.\n                                    </span>\n                                </div>\n                                <div class=\"index-item\" data-kid=\"1-2-4-2-2-4-1-3-2\" data-name=\"index item\">\n                                    <span class=\"num\" data-kid=\"1-2-4-2-2-4-1-3-2-1\" data-name=\"index item number\">\n                                        [02]\n                                    </span>\n                                    <span data-kid=\"1-2-4-2-2-4-1-3-2-2\" data-name=\"index item text\">\n                                        Turn personal brilliance into community impact.\n                                    </span>\n                                </div>\n                            </div>\n                        </article>\n                        <article class=\"purpose-panel mission-panel\" data-kid=\"1-2-4-2-2-4-2\" data-name=\"mission panel\" role=\"tabpanel\">\n                            <h4 data-kid=\"1-2-4-2-2-4-2-1\" data-name=\"mission panel title\">\n                                Make excellence public.\n                            </h4>\n                            <p data-kid=\"1-2-4-2-2-4-2-2\" data-name=\"mission panel body text\">\n                                We create opportunities for self-expression, personal growth, and visibility while celebrating beauty, culture, creativity, and individuality in a meaningful way.\n                            </p>\n                            <div class=\"index-list\" data-kid=\"1-2-4-2-2-4-2-3\" data-name=\"mission index list\">\n                                <div class=\"index-item\" data-kid=\"1-2-4-2-2-4-2-3-1\" data-name=\"index item\">\n                                    <span class=\"num\" data-kid=\"1-2-4-2-2-4-2-3-1-1\" data-name=\"index item number\">\n                                        [01]\n                                    </span>\n                                    <span data-kid=\"1-2-4-2-2-4-2-3-1-2\" data-name=\"index item text\">\n                                        Promote confidence, intelligence, talent, and leadership.\n                                    </span>\n                                </div>\n                                <div class=\"index-item\" data-kid=\"1-2-4-2-2-4-2-3-2\" data-name=\"index item\">\n                                    <span class=\"num\" data-kid=\"1-2-4-2-2-4-2-3-2-1\" data-name=\"index item number\">\n                                        [02]\n                                    </span>\n                                    <span data-kid=\"1-2-4-2-2-4-2-3-2-2\" data-name=\"index item text\">\n                                        Uphold a legacy of meaningful representation.\n                                    </span>\n                                </div>\n                                <div class=\"index-item\" data-kid=\"1-2-4-2-2-4-2-3-3\" data-name=\"index item\">\n                                    <span class=\"num\" data-kid=\"1-2-4-2-2-4-2-3-3-1\" data-name=\"index item number\">\n                                        [03]\n                                    </span>\n                                    <span data-kid=\"1-2-4-2-2-4-2-3-3-2\" data-name=\"index item text\">\n                                        Carry the UI identity beyond the campus.\n                                    </span>\n                                </div>\n                                <div class=\"index-item\" data-kid=\"1-2-4-2-2-4-2-3-4\" data-name=\"index item\">\n                                    <span class=\"num\" data-kid=\"1-2-4-2-2-4-2-3-4-1\" data-name=\"index item number\">\n                                        [04]\n                                    </span>\n                                    <span data-kid=\"1-2-4-2-2-4-2-3-4-2\" data-name=\"index item text\">\n                                        Celebrate the individual without flattening the story.\n                                    </span>\n                                </div>\n                            </div>\n                        </article>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"crown-title\" class=\"section crown-section\" data-kid=\"1-2-5\" data-name=\"crown section\" id=\"crown\">\n            <div class=\"section-head mono\" data-kid=\"1-2-5-1\" data-name=\"crown section header\">\n                <h2 data-kid=\"1-2-5-1-1\" data-name=\"crown section title\" id=\"crown-title\">\n                    <span class=\"section-index\" data-kid=\"1-2-5-1-1-1\" data-name=\"section index number\">\n                        03\n                    </span>\n                    / THE CROWN\n                </h2>\n                <span class=\"section-note\" data-kid=\"1-2-5-1-2\" data-name=\"section note text\">\n                    THE HALL OF FAME\n                </span>\n            </div>\n            <div class=\"crown-intro\" data-kid=\"1-2-5-2\" data-name=\"crown intro text\">\n                <h3 data-kid=\"1-2-5-2-1\" data-name=\"crown intro headline\">\n                    Not beauty alone.\n                    <br data-kid=\"1-2-5-2-1-1\" data-name=\"headline line break\">\n                    <span class=\"blue\" data-kid=\"1-2-5-2-1-2\" data-name=\"headline emphasis text\">\n                        A total presence.\n                    </span>\n                </h3>\n                <p data-kid=\"1-2-5-2-2\" data-name=\"crown intro body\">\n                    The crown bends toward those who hold many things at once: academic excellence, cultural identity, emotional intelligence, community impact, and an authentic presence.\n                </p>\n            </div>\n            <div aria-label=\"Hall of Fame portraits\" class=\"portrait-matrix\" data-kid=\"1-2-5-3\" data-name=\"portrait matrix\">\n                <figure class=\"portrait active\" data-kid=\"1-2-5-3-1\" data-name=\"portrait figure\">\n                    <img alt=\"Hall of Fame portrait one\" data-kid=\"1-2-5-3-1-1\" data-name=\"portrait image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/image1.png\">\n                    <figcaption class=\"portrait-tag\" data-kid=\"1-2-5-3-1-2\" data-name=\"portrait label\">\n                        <span data-kid=\"1-2-5-3-1-2-1\" data-name=\"portrait id text\">\n                            01 / LEGACY\n                        </span>\n                        <span data-kid=\"1-2-5-3-1-2-2\" data-name=\"portrait status text\">\n                            ACTIVE\n                        </span>\n                    </figcaption>\n                </figure>\n                <figure class=\"portrait\" data-kid=\"1-2-5-3-2\" data-name=\"portrait figure\">\n                    <img alt=\"Hall of Fame portrait two\" data-kid=\"1-2-5-3-2-1\" data-name=\"portrait image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/image2.png\">\n                    <figcaption class=\"portrait-tag\" data-kid=\"1-2-5-3-2-2\" data-name=\"portrait label\">\n                        <span data-kid=\"1-2-5-3-2-2-1\" data-name=\"portrait id text\">\n                            02 / LEGACY\n                        </span>\n                        <span data-kid=\"1-2-5-3-2-2-2\" data-name=\"portrait status text\">\n                            UI\n                        </span>\n                    </figcaption>\n                </figure>\n                <figure class=\"portrait\" data-kid=\"1-2-5-3-3\" data-name=\"portrait figure\">\n                    <img alt=\"Hall of Fame portrait three\" data-kid=\"1-2-5-3-3-1\" data-name=\"portrait image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/image3.png\">\n                    <figcaption class=\"portrait-tag\" data-kid=\"1-2-5-3-3-2\" data-name=\"portrait label\">\n                        <span data-kid=\"1-2-5-3-3-2-1\" data-name=\"portrait id text\">\n                            03 / LEGACY\n                        </span>\n                        <span data-kid=\"1-2-5-3-3-2-2\" data-name=\"portrait status text\">\n                            UI\n                        </span>\n                    </figcaption>\n                </figure>\n                <figure class=\"portrait\" data-kid=\"1-2-5-3-4\" data-name=\"portrait figure\">\n                    <img alt=\"Hall of Fame portrait four\" data-kid=\"1-2-5-3-4-1\" data-name=\"portrait image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/image4.png\">\n                    <figcaption class=\"portrait-tag\" data-kid=\"1-2-5-3-4-2\" data-name=\"portrait label\">\n                        <span data-kid=\"1-2-5-3-4-2-1\" data-name=\"portrait id text\">\n                            04 / LEGACY\n                        </span>\n                        <span data-kid=\"1-2-5-3-4-2-2\" data-name=\"portrait status text\">\n                            UI\n                        </span>\n                    </figcaption>\n                </figure>\n                <figure class=\"portrait\" data-kid=\"1-2-5-3-5\" data-name=\"portrait figure\">\n                    <img alt=\"Hall of Fame portrait five\" data-kid=\"1-2-5-3-5-1\" data-name=\"portrait image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/image5.png\">\n                    <figcaption class=\"portrait-tag\" data-kid=\"1-2-5-3-5-2\" data-name=\"portrait label\">\n                        <span data-kid=\"1-2-5-3-5-2-1\" data-name=\"portrait id text\">\n                            05 / LEGACY\n                        </span>\n                        <span data-kid=\"1-2-5-3-5-2-2\" data-name=\"portrait status text\">\n                            UI\n                        </span>\n                    </figcaption>\n                </figure>\n                <figure class=\"portrait\" data-kid=\"1-2-5-3-6\" data-name=\"portrait figure\">\n                    <img alt=\"Hall of Fame portrait six\" data-kid=\"1-2-5-3-6-1\" data-name=\"portrait image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/image6.png\">\n                    <figcaption class=\"portrait-tag\" data-kid=\"1-2-5-3-6-2\" data-name=\"portrait label\">\n                        <span data-kid=\"1-2-5-3-6-2-1\" data-name=\"portrait id text\">\n                            06 / LEGACY\n                        </span>\n                        <span data-kid=\"1-2-5-3-6-2-2\" data-name=\"portrait status text\">\n                            UI\n                        </span>\n                    </figcaption>\n                </figure>\n            </div>\n            <div class=\"crown-footer mono\" data-kid=\"1-2-5-4\" data-name=\"crown footer\">\n                <span data-kid=\"1-2-5-4-1\" data-name=\"crown features list\">\n                    ACADEMIC EXCELLENCE / CULTURAL IDENTITY / COMMUNITY IMPACT\n                </span>\n                <span class=\"blue\" data-kid=\"1-2-5-4-2\" data-name=\"crown hint text\">\n                    HOVER TO REVEAL\n                </span>\n            </div>\n        </section>\n        <section aria-labelledby=\"lineage-title\" class=\"section\" data-kid=\"1-2-6\" data-name=\"lineage section\">\n            <div class=\"section-head mono\" data-kid=\"1-2-6-1\" data-name=\"lineage section header\">\n                <h2 data-kid=\"1-2-6-1-1\" data-name=\"lineage section title\" id=\"lineage-title\">\n                    <span class=\"section-index\" data-kid=\"1-2-6-1-1-1\" data-name=\"section index number\">\n                        04\n                    </span>\n                    / THE LINEAGE\n                </h2>\n                <span class=\"section-note\" data-kid=\"1-2-6-1-2\" data-name=\"section note text\">\n                    EVERY CROWN LEAVES A SHADOW\n                </span>\n            </div>\n            <div class=\"lineage-list\" data-kid=\"1-2-6-2\" data-name=\"lineage list\">\n                <details class=\"lineage-row\" data-kid=\"1-2-6-2-1\" data-name=\"lineage row\" open=\"\">\n                    <summary data-kid=\"1-2-6-2-1-1\" data-name=\"lineage row summary\">\n                        <span class=\"lineage-no mono\" data-kid=\"1-2-6-2-1-1-1\" data-name=\"lineage index number\">\n                            01\n                        </span>\n                        <span class=\"lineage-name\" data-kid=\"1-2-6-2-1-1-2\" data-name=\"lineage names\">\n                            Olubaseyi Damilare\n                            <span class=\"blue\" data-kid=\"1-2-6-2-1-1-2-1\" data-name=\"lineage connector\">\n                                ×\n                            </span>\n                            Tobiloba Oluwole\n                        </span>\n                        <span class=\"lineage-year\" data-kid=\"1-2-6-2-1-1-3\" data-name=\"lineage year\">\n                            2024 / 25\n                        </span>\n                        <span class=\"lineage-field\" data-kid=\"1-2-6-2-1-1-4\" data-name=\"lineage field\">\n                            MATHEMATICS / THEATER ARTS\n                        </span>\n                        <span class=\"lineage-chevron\" data-kid=\"1-2-6-2-1-1-5\" data-name=\"lineage chevron\">\n                            +\n                        </span>\n                    </summary>\n                    <div class=\"lineage-reveal\" data-kid=\"1-2-6-2-1-2\" data-name=\"lineage reveal panel\">\n                        <img alt=\"Olubaseyi Damilare lineage portrait\" data-kid=\"1-2-6-2-1-2-1\" data-name=\"lineage image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/Images-Carousels/IMG_4798.PNG\">\n                        <div class=\"lineage-reveal-copy\" data-kid=\"1-2-6-2-1-2-2\" data-name=\"lineage reveal copy\">\n                            <p data-kid=\"1-2-6-2-1-2-2-1\" data-name=\"lineage copy text\">\n                                The reign begins with a visible standard: clarity, presence, and the courage to leave the platform stronger than you found it.\n                            </p>\n                            <span class=\"mono blue\" data-kid=\"1-2-6-2-1-2-2-2\" data-name=\"lineage archive label\">\n                                CURRENT RECORD / 01\n                            </span>\n                        </div>\n                    </div>\n                </details>\n                <details class=\"lineage-row\" data-kid=\"1-2-6-2-2\" data-name=\"lineage row\">\n                    <summary data-kid=\"1-2-6-2-2-1\" data-name=\"lineage row summary\">\n                        <span class=\"lineage-no mono\" data-kid=\"1-2-6-2-2-1-1\" data-name=\"lineage index number\">\n                            02\n                        </span>\n                        <span class=\"lineage-name\" data-kid=\"1-2-6-2-2-1-2\" data-name=\"lineage names\">\n                            Adegbenro Daniel Adebayo\n                            <span class=\"blue\" data-kid=\"1-2-6-2-2-1-2-1\" data-name=\"lineage connector\">\n                                ×\n                            </span>\n                            Onuoha Marvellous\n                        </span>\n                        <span class=\"lineage-year\" data-kid=\"1-2-6-2-2-1-3\" data-name=\"lineage year\">\n                            2023 / 24\n                        </span>\n                        <span class=\"lineage-field\" data-kid=\"1-2-6-2-2-1-4\" data-name=\"lineage field\">\n                            EUROPEAN STUDIES / SPECIAL EDUCATION\n                        </span>\n                        <span class=\"lineage-chevron\" data-kid=\"1-2-6-2-2-1-5\" data-name=\"lineage chevron\">\n                            +\n                        </span>\n                    </summary>\n                    <div class=\"lineage-reveal\" data-kid=\"1-2-6-2-2-2\" data-name=\"lineage reveal panel\">\n                        <img alt=\"Adegbenro Daniel Adebayo lineage portrait\" data-kid=\"1-2-6-2-2-2-1\" data-name=\"lineage image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/Images-Carousels/IMG_4796.PNG\">\n                        <div class=\"lineage-reveal-copy\" data-kid=\"1-2-6-2-2-2-2\" data-name=\"lineage reveal copy\">\n                            <p data-kid=\"1-2-6-2-2-2-2-1\" data-name=\"lineage copy text\">\n                                A lineage of influence, growth, and representation carried beyond the competition.\n                            </p>\n                            <span class=\"mono blue\" data-kid=\"1-2-6-2-2-2-2-2\" data-name=\"lineage archive label\">\n                                ARCHIVE / 02\n                            </span>\n                        </div>\n                    </div>\n                </details>\n                <details class=\"lineage-row\" data-kid=\"1-2-6-2-3\" data-name=\"lineage row\">\n                    <summary data-kid=\"1-2-6-2-3-1\" data-name=\"lineage row summary\">\n                        <span class=\"lineage-no mono\" data-kid=\"1-2-6-2-3-1-1\" data-name=\"lineage index number\">\n                            03\n                        </span>\n                        <span class=\"lineage-name\" data-kid=\"1-2-6-2-3-1-2\" data-name=\"lineage names\">\n                            Anthony Jasper Laris\n                            <span class=\"blue\" data-kid=\"1-2-6-2-3-1-2-1\" data-name=\"lineage connector\">\n                                ×\n                            </span>\n                            Oshinyemi Promise\n                        </span>\n                        <span class=\"lineage-year\" data-kid=\"1-2-6-2-3-1-3\" data-name=\"lineage year\">\n                            2022 / 23\n                        </span>\n                        <span class=\"lineage-field\" data-kid=\"1-2-6-2-3-1-4\" data-name=\"lineage field\">\n                            M.R UI / ARTS & SOCIAL SCIENCES\n                        </span>\n                        <span class=\"lineage-chevron\" data-kid=\"1-2-6-2-3-1-5\" data-name=\"lineage chevron\">\n                            +\n                        </span>\n                    </summary>\n                    <div class=\"lineage-reveal\" data-kid=\"1-2-6-2-3-2\" data-name=\"lineage reveal panel\">\n                        <img alt=\"Anthony Jasper Laris lineage portrait\" data-kid=\"1-2-6-2-3-2-1\" data-name=\"lineage image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/Images-Carousels/IMG_4793.PNG\">\n                        <div class=\"lineage-reveal-copy\" data-kid=\"1-2-6-2-3-2-2\" data-name=\"lineage reveal copy\">\n                            <p data-kid=\"1-2-6-2-3-2-2-1\" data-name=\"lineage copy text\">\n                                Each year adds a new mark to the institution’s visual and cultural memory.\n                            </p>\n                            <span class=\"mono blue\" data-kid=\"1-2-6-2-3-2-2-2\" data-name=\"lineage archive label\">\n                                ARCHIVE / 03\n                            </span>\n                        </div>\n                    </div>\n                </details>\n                <details class=\"lineage-row\" data-kid=\"1-2-6-2-4\" data-name=\"lineage row\">\n                    <summary data-kid=\"1-2-6-2-4-1\" data-name=\"lineage row summary\">\n                        <span class=\"lineage-no mono\" data-kid=\"1-2-6-2-4-1-1\" data-name=\"lineage index number\">\n                            04\n                        </span>\n                        <span class=\"lineage-name\" data-kid=\"1-2-6-2-4-1-2\" data-name=\"lineage names\">\n                            The Class of 2020\n                            <span class=\"blue\" data-kid=\"1-2-6-2-4-1-2-1\" data-name=\"lineage connector\">\n                                ×\n                            </span>\n                            The Class of 2020\n                        </span>\n                        <span class=\"lineage-year\" data-kid=\"1-2-6-2-4-1-3\" data-name=\"lineage year\">\n                            2020\n                        </span>\n                        <span class=\"lineage-field\" data-kid=\"1-2-6-2-4-1-4\" data-name=\"lineage field\">\n                            MR. & MRS. UI\n                        </span>\n                        <span class=\"lineage-chevron\" data-kid=\"1-2-6-2-4-1-5\" data-name=\"lineage chevron\">\n                            +\n                        </span>\n                    </summary>\n                    <div class=\"lineage-reveal\" data-kid=\"1-2-6-2-4-2\" data-name=\"lineage reveal panel\">\n                        <img alt=\"Class of 2020 lineage portrait\" data-kid=\"1-2-6-2-4-2-1\" data-name=\"lineage image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/Images-Carousels/image0.png\">\n                        <div class=\"lineage-reveal-copy\" data-kid=\"1-2-6-2-4-2-2\" data-name=\"lineage reveal copy\">\n                            <p data-kid=\"1-2-6-2-4-2-2-1\" data-name=\"lineage copy text\">\n                                The archive is never closed. The next chapter is waiting for its own names.\n                            </p>\n                            <span class=\"mono blue\" data-kid=\"1-2-6-2-4-2-2-2\" data-name=\"lineage archive label\">\n                                ARCHIVE / 04\n                            </span>\n                        </div>\n                    </div>\n                </details>\n            </div>\n        </section>\n        <section aria-labelledby=\"night-title\" class=\"section night\" data-kid=\"1-2-7\" data-name=\"night section\" id=\"night\">\n            <div class=\"section-head mono\" data-kid=\"1-2-7-1\" data-name=\"night section header\">\n                <h2 data-kid=\"1-2-7-1-1\" data-name=\"night section title\" id=\"night-title\">\n                    <span class=\"section-index\" data-kid=\"1-2-7-1-1-1\" data-name=\"section index number\">\n                        05\n                    </span>\n                    / THE NIGHT\n                </h2>\n                <span class=\"section-note\" data-kid=\"1-2-7-1-2\" data-name=\"section note text\">\n                    THE LEGACY EDITION\n                </span>\n            </div>\n            <div class=\"ticket-wrap\" data-kid=\"1-2-7-2\" data-name=\"ticket wrapper\">\n                <div class=\"ticket-info\" data-kid=\"1-2-7-2-1\" data-name=\"ticket info container\">\n                    <span class=\"mono blue\" data-kid=\"1-2-7-2-1-1\" data-name=\"ticket admit label\">\n                        ADMIT ONE / 2026\n                    </span>\n                    <h3 data-kid=\"1-2-7-2-1-2\" data-name=\"ticket main headline\">\n                 