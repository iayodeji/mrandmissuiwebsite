      },
      "html": "<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap');\n  :root {\n    --ink: #10100f;\n    --paper: #f3efe7;\n    --muted: #b9b2a6;\n    --bronze: #b18d5b;\n    --bronze-light: #d2b989;\n    --line: rgba(243,239,231,.2);\n    --panel: #191816;\n  }\n  html { scroll-behavior: smooth; }\n  body { background: var(--ink); color: var(--paper); font-family: 'DM Sans', sans-serif; }\n  .editorial-serif { font-family: 'Playfair Display', Georgia, serif; }\n  .editorial-mono { font-family: 'DM Mono', monospace; }\n  .hairline { border-color: var(--line); }\n  .text-muted { color: var(--muted); }\n  .text-bronze { color: var(--bronze-light); }\n  .bg-panel { background: var(--panel); }\n  .focus-ring:focus-visible { outline: 2px solid var(--bronze-light); outline-offset: 4px; }\n  .image-sepia { filter: sepia(.22) saturate(.72) contrast(1.04); }\n  .image-sepia:hover { filter: sepia(.04) saturate(.94) contrast(1.08); }\n  .nav-scroll { scrollbar-width: none; }\n  .nav-scroll::-webkit-scrollbar { display: none; }\n  .hero-display { font-size: clamp(4.8rem, 10.8vw, 10.8rem); line-height: .83; letter-spacing: -.075em; }\n  .section-display { font-size: clamp(3rem, 7vw, 7.5rem); line-height: .88; letter-spacing: -.065em; }\n  .rule-label::before { content: ''; display: inline-block; width: 2.4rem; height: 1px; background: var(--bronze); margin-right: .75rem; vertical-align: middle; }\n  .hero-image-mask { clip-path: polygon(12% 0, 100% 0, 100% 100%, 0 100%, 0 18%); }\n  .portrait-caption { opacity: 0; transform: translateY(8px); transition: opacity .35s ease, transform .35s ease; }\n  .portrait-frame:hover .portrait-caption, .portrait-frame:focus-within .portrait-caption { opacity: 1; transform: translateY(0); }\n  .vertical-rail { writing-mode: vertical-rl; transform: rotate(180deg); }\n  .mobile-nav { display: none; }\n  @media (max-width: 820px) {\n    .desktop-nav { display: none; }\n    .mobile-nav { display: flex; }\n    .hero-grid { grid-template-columns: 1fr !important; }\n    .hero-art { min-height: 24rem; order: -1; }\n    .hero-copy { padding-top: 2rem !important; }\n    .hero-display { font-size: clamp(4rem, 18vw, 7rem); }\n    .purpose-grid { grid-template-columns: 1fr !important; }\n    .purpose-rail { position: static !important; border-right: 0 !important; border-bottom: 1px solid var(--line); padding-bottom: 2rem; }\n    .gallery-grid { grid-template-columns: 1fr 1fr !important; }\n    .night-grid { grid-template-columns: 1fr !important; }\n  }\n  @media (max-width: 520px) {\n    .gallery-grid { grid-template-columns: 1fr !important; }\n    .stats-ribbon { grid-template-columns: 1fr !important; }\n    .stats-ribbon > div { border-right: 0 !important; border-bottom: 1px solid var(--line); }\n    .stats-ribbon > div:last-child { border-bottom: 0; }\n    .hero-display { font-size: clamp(3.7rem, 19vw, 5.7rem); }\n  }\n</style>\n<div class=\"min-h-screen overflow-hidden bg-[#10100f] text-[#f3efe7] selection:bg-[#b18d5b] selection:text-[#10100f]\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"fixed inset-x-0 top-0 z-50 border-b hairline bg-[#10100f]/90 backdrop-blur-md\" data-kid=\"1-1\" data-name=\"header container\">\n        <div class=\"mx-auto flex max-w-[1440px] items-center justify-between gap-6 px-6 py-4 lg:px-12\" data-kid=\"1-1-1\" data-name=\"header row\">\n            <a class=\"focus-ring shrink-0 editorial-mono text-[10px] font-medium uppercase tracking-[.32em] text-[#d2b989]\" data-kid=\"1-1-1-1\" data-name=\"site brand name link\" href=\"#hero\">\n                Mr & Miss UI\n                <span class=\"text-[#807a70]\" data-kid=\"1-1-1-1-1\" data-name=\"site brand year\">\n                    / 2026\n                </span>\n            </a>\n            <nav aria-label=\"Primary navigation\" class=\"desktop-nav flex items-center gap-7 editorial-mono text-[10px] uppercase tracking-[.18em] text-[#b9b2a6]\" data-kid=\"1-1-1-2\" data-name=\"primary navigation menu\">\n                <a class=\"focus-ring transition-colors hover:text-[#d2b989]\" data-kid=\"1-1-1-2-1\" data-name=\"calling navigation link\" href=\"#calling\">\n                    01 Calling\n                </a>\n                <a class=\"focus-ring transition-colors hover:text-[#d2b989]\" data-kid=\"1-1-1-2-2\" data-name=\"purpose navigation link\" href=\"#purpose\">\n                    02 Purpose\n                </a>\n                <a class=\"focus-ring transition-colors hover:text-[#d2b989]\" data-kid=\"1-1-1-2-3\" data-name=\"hall of fame navigation link\" href=\"#hall-of-fame\">\n                    03 Crown\n                </a>\n                <a class=\"focus-ring transition-colors hover:text-[#d2b989]\" data-kid=\"1-1-1-2-4\" data-name=\"lineage navigation link\" href=\"#lineage\">\n                    04 Lineage\n                </a>\n                <a class=\"focus-ring transition-colors hover:text-[#d2b989]\" data-kid=\"1-1-1-2-5\" data-name=\"night navigation link\" href=\"#the-night\">\n                    05 The Night\n                </a>\n            </nav>\n            <a class=\"focus-ring hidden shrink-0 border border-[#b18d5b] px-4 py-2 editorial-mono text-[10px] uppercase tracking-[.16em] text-[#d2b989] transition-colors hover:bg-[#b18d5b] hover:text-[#10100f] sm:block\" data-kid=\"1-1-1-3\" data-name=\"programme call to action button\" href=\"#the-night\">\n                Programme\n            </a>\n        </div>\n        <nav aria-label=\"Mobile navigation\" class=\"mobile-nav nav-scroll gap-6 overflow-x-auto border-t hairline px-6 py-3 editorial-mono text-[9px] uppercase tracking-[.16em] text-[#b9b2a6]\" data-kid=\"1-1-2\" data-name=\"mobile navigation menu\">\n            <a class=\"focus-ring shrink-0 text-[#d2b989]\" data-kid=\"1-1-2-1\" data-name=\"calling mobile link\" href=\"#calling\">\n                01 Calling\n            </a>\n            <a class=\"focus-ring shrink-0\" data-kid=\"1-1-2-2\" data-name=\"purpose mobile link\" href=\"#purpose\">\n                02 Purpose\n            </a>\n            <a class=\"focus-ring shrink-0\" data-kid=\"1-1-2-3\" data-name=\"hall of fame mobile link\" href=\"#hall-of-fame\">\n                03 Crown\n            </a>\n            <a class=\"focus-ring shrink-0\" data-kid=\"1-1-2-4\" data-name=\"lineage mobile link\" href=\"#lineage\">\n                04 Lineage\n            </a>\n            <a class=\"focus-ring shrink-0\" data-kid=\"1-1-2-5\" data-name=\"night mobile link\" href=\"#the-night\">\n                05 The Night\n            </a>\n        </nav>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main content container\">\n        <section class=\"hero-grid grid min-h-screen grid-cols-[.92fr_1.08fr] border-b hairline pt-24\" data-kid=\"1-2-1\" data-name=\"hero section\" id=\"hero\">\n            <div class=\"hero-copy relative flex flex-col justify-between px-6 pb-10 pt-16 lg:px-16 lg:pt-24\" data-kid=\"1-2-1-1\" data-name=\"hero copy column\">\n                <div data-kid=\"1-2-1-1-1\" data-name=\"hero intro container\">\n                    <p class=\"rule-label editorial-mono text-[10px] uppercase tracking-[.32em] text-[#d2b989]\" data-kid=\"1-2-1-1-1-1\" data-name=\"hero university label\">\n                        University of Ibadan · The Legacy Edition\n                    </p>\n                    <div class=\"relative mt-12 lg:mt-16\" data-kid=\"1-2-1-1-1-2\" data-name=\"hero title container\">\n                        <span class=\"pointer-events-none absolute -left-4 -top-16 editorial-mono text-[9rem] font-medium leading-none text-white/[.035] lg:-left-10 lg:-top-24 lg:text-[18rem]\" data-kid=\"1-2-1-1-1-2-1\" data-name=\"hero year background text\">\n                            26\n                        </span>\n                        <h1 class=\"hero-display editorial-serif relative max-w-[760px] font-medium text-[#f3efe7]\" data-kid=\"1-2-1-1-1-2-2\" data-name=\"hero headline\">\n                            Mr &\n                            <br data-kid=\"1-2-1-1-1-2-2-1\" data-name=\"hero title line break\">\n                            <em class=\"text-[#d2b989]\" data-kid=\"1-2-1-1-1-2-2-2\" data-name=\"hero headline emphasized word\">\n                                Miss\n                            </em>\n                            <br data-kid=\"1-2-1-1-1-2-2-3\" data-name=\"hero title line break\">\n                            Unibadan\n                        </h1>\n                    </div>\n                    <div class=\"mt-10 max-w-[28rem] border-l border-[#b18d5b] pl-5\" data-kid=\"1-2-1-1-1-3\" data-name=\"hero subheadline container\">\n                        <p class=\"editorial-serif text-xl leading-relaxed text-[#d7d0c4]\" data-kid=\"1-2-1-1-1-3-1\" data-name=\"hero subheadline text\">\n                            Where brilliance meets grace — a living archive of confidence, intelligence, leadership, and presence.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"mt-16 flex flex-wrap items-end justify-between gap-8\" data-kid=\"1-2-1-1-2\" data-name=\"hero call to action container\">\n                    <a class=\"focus-ring inline-flex items-center gap-4 bg-[#b18d5b] px-6 py-4 editorial-mono text-[10px] uppercase tracking-[.2em] text-[#10100f] transition-colors hover:bg-[#d2b989]\" data-kid=\"1-2-1-1-2-1\" data-name=\"hero primary action button\" href=\"#calling\">\n                        View the programme\n                        <span aria-hidden=\"true\" data-kid=\"1-2-1-1-2-1-1\" data-name=\"arrow icon\">\n                            ↘\n                        </span>\n                    </a>\n                    <div class=\"editorial-mono text-[9px] uppercase tracking-[.22em] text-[#807a70]\" data-kid=\"1-2-1-1-2-2\" data-name=\"scroll prompt text\">\n                        Scroll to enter\n                        <br data-kid=\"1-2-1-1-2-2-1\" data-name=\"scroll prompt line break\">\n                        <span class=\"text-[#d2b989]\" data-kid=\"1-2-1-1-2-2-2\" data-name=\"scroll arrow icon\">\n                            ↓\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"hero-art relative min-h-[42rem] overflow-hidden border-l hairline bg-[#24211d]\" data-kid=\"1-2-1-2\" data-name=\"hero visual art column\">\n                <img alt=\"Purple stage curtains from Mr and Miss Unibadan event history\" class=\"hero-image-mask image-sepia absolute inset-0 h-full w-full object-cover\" data-kid=\"1-2-1-2-1\" data-name=\"hero feature image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/image0.jpeg\">\n                <div class=\"absolute inset-0 bg-gradient-to-r from-[#10100f]/90 via-[#10100f]/10 to-transparent\" data-kid=\"1-2-1-2-2\" data-name=\"hero image gradient overlay\">\n                </div>\n                <div class=\"absolute bottom-8 left-8 right-8 flex items-end justify-between gap-6 lg:left-12 lg:right-12\" data-kid=\"1-2-1-2-3\" data-name=\"hero image caption container\">\n                    <div data-kid=\"1-2-1-2-3-1\" data-name=\"hero image title container\">\n                        <p class=\"editorial-mono text-[9px] uppercase tracking-[.26em] text-[#d2b989]\" data-kid=\"1-2-1-2-3-1-1\" data-name=\"hero image sublabel\">\n                            A ceremony of becoming\n                        </p>\n                        <p class=\"mt-2 editorial-serif text-2xl italic text-[#f3efe7]\" data-kid=\"1-2-1-2-3-1-2\" data-name=\"hero image subtitle\">\n                            15 years of crystal excellence\n                        </p>\n                    </div>\n                    <span class=\"vertical-rail editorial-mono text-[9px] uppercase tracking-[.24em] text-[#d2b989]\" data-kid=\"1-2-1-2-3-2\" data-name=\"hero vertical rail text\">\n                        Portrait · 01 / 05\n                    </span>\n                </div>\n            </div>\n        </section>\n        <section class=\"mx-auto max-w-[1440px] px-6 py-24 lg:px-16 lg:py-36\" data-kid=\"1-2-2\" data-name=\"calling section\" id=\"calling\">\n            <div class=\"grid gap-14 lg:grid-cols-[.8fr_1.2fr] lg:gap-24\" data-kid=\"1-2-2-1\" data-name=\"calling content grid\">\n                <div data-kid=\"1-2-2-1-1\" data-name=\"calling header container\">\n                    <p class=\"rule-label editorial-mono text-[10px] uppercase tracking-[.3em] text-[#d2b989]\" data-kid=\"1-2-2-1-1-1\" data-name=\"calling rule label\">\n                        01 / The Calling\n                    </p>\n                    <h2 class=\"section-display editorial-serif mt-10 text-[#f3efe7]\" data-kid=\"1-2-2-1-1-2\" data-name=\"calling headline\">\n                        A platform\n                        <br data-kid=\"1-2-2-1-1-2-1\" data-name=\"calling headline line break\">\n                        <em class=\"text-[#d2b989]\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"calling emphasized text\">\n                            with purpose.\n                        </em>\n                    </h2>\n                </div>\n                <div class=\"max-w-[47rem] self-end\" data-kid=\"1-2-2-1-2\" data-name=\"calling body container\">\n                    <p class=\"editorial-serif text-3xl leading-[1.18] text-[#f3efe7]\" data-kid=\"1-2-2-1-2-1\" data-name=\"calling description paragraph\">\n                        For over 15 years, Mr. & Mrs. UI has stood as one of the most prestigious and culturally celebrated pageantry platforms within the University of Ibadan community.\n                    </p>\n                    <p class=\"mt-8 max-w-[42rem] text-base leading-8 text-[#b9b2a6]\" data-kid=\"1-2-2-1-2-2\" data-name=\"calling detail paragraph\">\n                        More than a beauty pageant, it is a platform dedicated to discovering and showcasing students who embody excellence, confidence, intelligence, creativity, leadership, and social influence.\n                    </p>\n                    <div class=\"stats-ribbon mt-16 grid grid-cols-3 border-y hairline\" data-kid=\"1-2-2-1-2-3\" data-name=\"calling stats ribbon\">\n                        <div class=\"py-6 pr-6 lg:py-8\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"stat item one\">\n                            <p class=\"editorial-serif text-5xl text-[#d2b989]\" data-kid=\"1-2-2-1-2-3-1-1\" data-name=\"stat value one\">\n                                01\n                            </p>\n                            <p class=\"mt-2 editorial-mono text-[9px] uppercase tracking-[.2em] text-[#807a70]\" data-kid=\"1-2-2-1-2-3-1-2\" data-name=\"stat label one\">\n                                University\n                            </p>\n                        </div>\n                        <div class=\"border-l hairline px-6 py-6 lg:py-8\" data-kid=\"1-2-2-1-2-3-2\" data-name=\"stat item two\">\n                            <p class=\"editorial-serif text-5xl text-[#d2b989]\" data-kid=\"1-2-2-1-2-3-2-1\" data-name=\"stat value two\">\n                                03\n                            </p>\n                            <p class=\"mt-2 editorial-mono text-[9px] uppercase tracking-[.2em] text-[#807a70]\" data-kid=\"1-2-2-1-2-3-2-2\" data-name=\"stat label two\">\n                                Crowns\n                            </p>\n                        </div>\n                        <div class=\"border-l hairline px-6 py-6 lg:py-8\" data-kid=\"1-2-2-1-2-3-3\" data-name=\"stat item three\">\n                            <p class=\"editorial-serif text-5xl text-[#d2b989]\" data-kid=\"1-2-2-1-2-3-3-1\" data-name=\"stat value three\">\n                                15\n                            </p>\n                            <p class=\"mt-2 editorial-mono text-[9px] uppercase tracking-[.2em] text-[#807a70]\" data-kid=\"1-2-2-1-2-3-3-2\" data-name=\"stat label three\">\n                                Years of legacy\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-y hairline bg-[#191816]\" data-kid=\"1-2-3\" data-name=\"purpose section\" id=\"purpose\">\n            <div class=\"purpose-grid mx-auto grid max-w-[1440px] grid-cols-[.6fr_1.4fr] lg:grid-cols-[.65fr_1.35fr]\" data-kid=\"1-2-3-1\" data-name=\"purpose grid container\">\n                <aside class=\"purpose-rail sticky top-24 self-start border-r hairline px-6 py-20 lg:px-16 lg:py-28\" data-kid=\"1-2-3-1-1\" data-name=\"purpose sidebar rail\">\n                    <p class=\"rule-label editorial-mono text-[10px] uppercase tracking-[.3em] text-[#d2b989]\" data-kid=\"1-2-3-1-1-1\" data-name=\"purpose rule label\">\n                        02 / The Journey\n                    </p>\n                    <h2 class=\"mt-8 editorial-serif text-6xl leading-[.9] text-[#f3efe7]\" data-kid=\"1-2-3-1-1-2\" data-name=\"purpose headline\">\n                        Our\n                        <br data-kid=\"1-2-3-1-1-2-1\" data-name=\"purpose headline line break\">\n                        <em class=\"text-[#d2b989]\" data-kid=\"1-2-3-1-1-2-2\" data-name=\"purpose emphasized text\">\n                            Purpose\n                        </em>\n                    </h2>\n                    <p class=\"mt-10 max-w-[15rem] text-sm leading-7 text-[#9f988e]\" data-kid=\"1-2-3-1-1-3\" data-name=\"purpose subheadline text\">\n                        A crown is only meaningful when it gives the wearer somewhere to stand.\n                    </p>\n                    <div class=\"mt-16 editorial-mono text-[9px] uppercase tracking-[.2em] text-[#807a70]\" data-kid=\"1-2-3-1-1-4\" data-name=\"purpose navigation marker\">\n                        Vision\n                        <br data-kid=\"1-2-3-1-1-4-1\" data-name=\"purpose marker line break\">\n                        <span class=\"my-3 block h-10 w-px bg-[#b18d5b]\" data-kid=\"1-2-3-1-1-4-2\" data-name=\"purpose marker vertical line\">\n                        </span>\n                        Mission\n                    </div>\n                </aside>\n                <div class=\"px-6 py-20 lg:px-20 lg:py-28\" data-kid=\"1-2-3-1-2\" data-name=\"purpose content area\">\n                    <article class=\"border-b hairline pb-16 lg:pb-24\" data-kid=\"1-2-3-1-2-1\" data-name=\"purpose vision article\">\n                        <p class=\"editorial-mono text-[10px] uppercase tracking-[.28em] text-[#807a70]\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"purpose vision label\">\n                            A / Vision\n                        </p>\n                        <h3 class=\"editorial-serif mt-8 text-5xl leading-none text-[#f3efe7] lg:text-7xl\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"purpose vision title\">\n                            Beyond the crown.\n                        </h3>\n                        <p class=\"mt-8 max-w-[40rem] text-lg leading-8 text-[#c9c2b7]\" data-kid=\"1-2-3-1-2-1-3\" data-name=\"purpose vision body\">\n                            To build a prestigious platform that empowers students to become symbols of excellence, leadership, creativity, and positive influence within the university community and beyond.\n                        </p>\n                    </article>\n                    <article class=\"pt-16 lg:pt-24\" data-kid=\"1-2-3-1-2-2\" data-name=\"purpose mission article\">\n                        <p class=\"editorial-mono text-[10px] uppercase tracking-[.28em] text-[#807a70]\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"purpose mission label\">\n                            B / Mission\n                        </p>\n                        <h3 class=\"editorial-serif mt-8 text-5xl leading-none text-[#f3efe7] lg:text-7xl\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"purpose mission title\">\n                            Make presence\n                            <br data-kid=\"1-2-3-1-2-2-2-1\" data-name=\"mission title line break\">\n                            <em class=\"text-[#d2b989]\" data-kid=\"1-2-3-1-2-2-2-2\" data-name=\"mission emphasized text\">\n                                matter.\n                            </em>\n                        </h3>\n                        <ol class=\"mt-10 max-w-[45rem] divide-y divide-[#f3efe7]/10 border-y hairline\" data-kid=\"1-2-3-1-2-2-3\" data-name=\"mission points list\">\n                            <li class=\"flex gap-6 py-5 text-base leading-7 text-[#c9c2b7]\" data-kid=\"1-2-3-1-2-2-3-1\" data-name=\"mission point one\">\n                                <span class=\"editorial-mono text-[10px] text-[#b18d5b]\" data-kid=\"1-2-3-1-2-2-3-1-1\" data-name=\"mission point index one\">\n                                    01\n                                </span>\n                                <span data-kid=\"1-2-3-1-2-2-3-1-2\" data-name=\"mission point text one\">\n                                    Promote confidence, intelligence, talent, and leadership among students.\n                                </span>\n                            </li>\n                            <li class=\"flex gap-6 py-5 text-base leading-7 text-[#c9c2b7]\" data-kid=\"1-2-3-1-2-2-3-2\" data-name=\"mission point two\">\n                                <span class=\"editorial-mono text-[10px] text-[#b18d5b]\" data-kid=\"1-2-3-1-2-2-3-2-1\" data-name=\"mission point index two\">\n                                    02\n                                </span>\n                                <span data-kid=\"1-2-3-1-2-2-3-2-2\" data-name=\"mission point text two\">\n                                    Create opportunities for self-expression, personal growth, and visibility.\n                                </span>\n                            </li>\n                            <li class=\"flex gap-6 py-5 text-base leading-7 text-[#c9c2b7]\" data-kid=\"1-2-3-1-2-2-3-3\" data-name=\"mission point three\">\n                                <span class=\"editorial-mono text-[10px] text-[#b18d5b]\" data-kid=\"1-2-3-1-2-2-3-3-1\" data-name=\"mission point index three\">\n                                    03\n                                </span>\n                                <span data-kid=\"1-2-3-1-2-2-3-3-2\" data-name=\"mission point text three\">\n                                    Celebrate beauty, culture, creativity, and individuality in a meaningful way.\n                                </span>\n                            </li>\n                            <li class=\"flex gap-6 py-5 text-base leading-7 text-[#c9c2b7]\" data-kid=\"1-2-3-1-2-2-3-4\" data-name=\"mission point four\">\n                                <span class=\"editorial-mono text-[10px] text-[#b18d5b]\" data-kid=\"1-2-3-1-2-2-3-4-1\" data-name=\"mission point index four\">\n                                    04\n                                </span>\n                                <span data-kid=\"1-2-3-1-2-2-3-4-2\" data-name=\"mission point text four\">\n                                    Uphold a legacy of excellence and impactful representation within UI.\n                                </span>\n                            </li>\n                        </ol>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section class=\"mx-auto max-w-[1440px] px-6 py-24 lg:px-16 lg:py-36\" data-kid=\"1-2-4\" data-name=\"hall of fame section\" id=\"hall-of-fame\">\n            <div class=\"flex flex-col justify-between gap-8 border-b hairline pb-10 md:flex-row md:items-end\" data-kid=\"1-2-4-1\" data-name=\"hall of fame header container\">\n                <div data-kid=\"1-2-4-1-1\" data-name=\"hall of fame title group\">\n                    <p class=\"rule-label editorial-mono text-[10px] uppercase tracking-[.3em] text-[#d2b989]\" data-kid=\"1-2-4-1-1-1\" data-name=\"hall of fame rule label\">\n                        03 / What the Crown Demands\n                    </p>\n                    <h2 class=\"section-display editorial-serif mt-8 text-[#f3efe7]\" data-kid=\"1-2-4-1-1-2\" data-name=\"hall of fame title\">\n                        The Hall\n                        <br data-kid=\"1-2-4-1-1-2-1\" data-name=\"hall of fame title line break\">\n                        <em class=\"text-[#d2b989]\" data-kid=\"1-2-4-1-1-2-2\" data-name=\"hall of fame title emphasis\">\n                            of Fame\n                        </em>\n                    </h2>\n                </div>\n                <p class=\"max-w-[21rem] text-sm leading-7 text-[#9f988e]\" data-kid=\"1-2-4-1-2\" data-name=\"hall of fame description\">\n                    Not beauty alone. Not grades alone. The crown bends toward those who hold all things at once.\n                </p>\n            </div>\n            <div class=\"gallery-grid mt-16 grid grid-cols-[1.1fr_.9fr_1fr] items-start gap-5 lg:gap-8\" data-kid=\"1-2-4-2\" data-name=\"hall of fame gallery grid\">\n                <a class=\"portrait-frame focus-ring group relative mt-10 block lg:mt-24\" data-kid=\"1-2-4-2-1\" data-name=\"portrait card one\" href=\"#lineage\">\n                    <img alt=\"Mr Unibadan legacy portrait\" class=\"image-sepia aspect-[3/4] w-full object-cover transition-[filter] duration-500\" data-kid=\"1-2-4-2-1-1\" data-name=\"portrait image one\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/Images-Carousels/IMG_4798.PNG\">\n                    <div class=\"portrait-caption absolute inset-x-0 bottom-0 bg-[#10100f]/90 p-5\" data-kid=\"1-2-4-2-1-2\" data-name=\"portrait caption one\">\n                        <p class=\"editorial-mono text-[9px] uppercase tracking-[.22em] text-[#d2b989]\" data-kid=\"1-2-4-2-1-2-1\" data-name=\"portrait label one\">\n                            The King · 2024\n                        </p>\n                        <p class=\"mt-2 editorial-serif text-2xl\" data-kid=\"1-2-4-2-1-2-2\" data-name=\"portrait name one\">\n                            Olubaseyi Damilare\n                        </p>\n                    </div>\n                </a>\n                <a class=\"portrait-frame focus-ring group relative block\" data-kid=\"1-2-4-2-2\" data-name=\"portrait card two\" href=\"#lineage\">\n                    <img alt=\"Mr and Miss UI lineage portrait\" class=\"image-sepia aspect-[4/5] w-full object-cover transition-[filter] duration-500\" data-kid=\"1-2-4-2-2-1\" data-name=\"portrait image two\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/Images-Carousels/IMG_4796.PNG\">\n                    <div class=\"portrait-caption absolute inset-x-0 bottom-0 bg-[#10100f]/90 p-5\" data-kid=\"1-2-4-2-2-2\" data-name=\"portrait caption two\">\n                        <p class=\"editorial-mono text-[9px] uppercase tracking-[.22em] text-[#d2b989]\" data-kid=\"1-2-4-2-2-2-1\" data-name=\"portrait label two\">\n                            The Lineage · 2022\n                        </p>\n                        <p class=\"mt-2 editorial-serif text-2xl\" data-kid=\"1-2-4-2-2-2-2\" data-name=\"portrait name two\">\n                            A standard carried forward\n                        </p>\n                    </div>\n                </a>\n                <div class=\"space-y-8\" data-kid=\"1-2-4-2-3\" data-name=\"portrait sidebar container\">\n                    <a class=\"portrait-frame focus-ring group relative block\" data-kid=\"1-2-4-2-3-1\" data-name=\"portrait card three\" href=\"#lineage\">\n                        <img alt=\"Queen of the Mr and Miss UI legacy portrait\" class=\"image-sepia aspect-[4/3] w-full object-cover transition-[filter] duration-500\" data-kid=\"1-2-4-2-3-1-1\" data-name=\"portrait image three\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/Images-Carousels/IMG_4793.PNG\">\n                        <div class=\"portrait-caption absolute inset-x-0 bottom-0 bg-[#10100f]/90 p-5\" data-kid=\"1-2-4-2-3-1-2\" data-name=\"portrait caption three\">\n                            <p class=\"editorial-mono text-[9px] uppercase tracking-[.22em] text-[#d2b989]\" data-kid=\"1-2-4-2-3-1-2-1\" data-name=\"portrait label three\">\n                                The Crown · 2021\n                            </p>\n                            <p class=\"mt-2 editorial-serif text-2xl\" data-kid=\"1-2-4-2-3-1-2-2\" data-name=\"portrait name three\">\n                                Oshinyemi Promise Ogoluwa\n                            </p>\n                        </div>\n                    </a>\n                    <a class=\"portrait-frame focus-ring group relative block\" data-kid=\"1-2-4-2-3-2\" data-name=\"portrait card four\" href=\"#lineage\">\n                        <img alt=\"Mr and Miss UI historical portrait\" class=\"image-sepia aspect-[4/5] w-full object-cover transition-[filter] duration-500\" data-kid=\"1-2-4-2-3-2-1\" data-name=\"portrait image four\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/Images-Carousels/image7.png\">\n                        <div class=\"portrait-caption absolute inset-x-0 bottom-0 bg-[#10100f]/90 p-5\" data-kid=\"1-2-4-2-3-2-2\" data-name=\"portrait caption four\">\n                            <p class=\"editorial-mono text-[9px] uppercase tracking-[.22em] text-[#d2b989]\" data-kid=\"1-2-4-2-3-2-2-1\" data-name=\"portrait label four\">\n                                Archive / 2020\n                            </p>\n                            <p class=\"mt-2 editorial-serif text-2xl\" data-kid=\"1-2-4-2-3-2-2-2\" data-name=\"portrait name four\">\n                                A lasting mark\n                            </p>\n                        </div>\n                    </a>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-y hairline bg-[#191816]\" data-kid=\"1-2-5\" data-name=\"lineage section\" id=\"lineage\">\n            <div class=\"mx-auto max-w-[1440px] px-6 py-24 lg:px-16 lg:py-36\" data-kid=\"1-2-5-1\" data-name=\"lineage inner container\">\n                <div class=\"grid gap-16 lg:grid-cols-[.65fr_1.35fr] lg:items-end\" data-kid=\"1-2-5-1-1\" data-name=\"lineage header grid\">\n                    <div data-kid=\"1-2-5-1-1-1\" data-name=\"lineage title group\">\n                        <p class=\"rule-label editorial-mono text-[10px] uppercase tracking-[.3em] text-[#d2b989]\" data-kid=\"1-2-5-1-1-1-1\" data-name=\"lineage rule label\">\n                            04 / The Lineage\n                        </p>\n                        <h2 class=\"section-display editorial-serif mt-8 text-[#f3efe7]\" data-kid=\"1-2-5-1-1-1-2\" data-name=\"lineage headline\">\n                            Every crown\n                            <br data-kid=\"1-2-5-1-1-1-2-1\" data-name=\"lineage headline line break\">\n                            leaves a\n                            <em class=\"text-[#d2b989]\" data-kid=\"1-2-5-1-1-1-2-2\" data-name=\"lineage emphasized text\">\n                                shadow.\n                            </em>\n                        </h2>\n                    </div>\n                    <p class=\"max-w-[34rem] text-lg leading-8 text-[#b9b2a6]\" data-kid=\"1-2-5-1-1-2\" data-name=\"lineage body text\">\n                        Each year, a new story. Each reign, a lasting mark. The archive is not a roll call — it is a measure of what the platform makes possible.\n                    </p>\n                </div>\n                <div class=\"mt-20 border-y hairline\" data-kid=\"1-2-5-1-2\" data-name=\"lineage record table\">\n                    <div class=\"grid grid-cols-[5rem_1fr_auto] items-center gap-5 border-b hairline py-5 editorial-mono text-[9px] uppercase tracking-[.22em] text-[#807a70]\" data-kid=\"1-2-5-1-2-1\" data-name=\"lineage table header\">\n                        <span data-kid=\"1-2-5-1-2-1-1\" data-name=\"lineage table header year\">\n                            Year\n                        </span>\n                        <span data-kid=\"1-2-5-1-2-1-2\" data-name=\"lineage table header name\">\n                            Name\n                        </span>\n                        <span data-kid=\"1-2-5-1-2-1-3\" data-name=\"lineage table header field\">\n                            Field\n                        </span>\n                    </div>\n                    <div class=\"group grid grid-cols-[5rem_1fr_auto] items-center gap-5 border-b hairline py-7 transition-colors hover:bg-[#24211d]\" data-kid=\"1-2-5-1-2-2\" data-name=\"lineage record row one\">\n                        <span class=\"editorial-mono text-xs text-[#b18d5b]\" data-kid=\"1-2-5-1-2-2-1\" data-name=\"record year one\">\n                            2024\n                        </span>\n                        <span class=\"editorial-serif text-3xl text-[#f3efe7]\" data-kid=\"1-2-5-1-2-2-2\" data-name=\"record name one\">\n                            Olubaseyi Damilare\n                            <span class=\"text-[#807a70]\" data-kid=\"1-2-5-1-2-2-2-1\" data-name=\"record subname one\">\n                                & Tobiloba Oluwole\n                            </span>\n                        </span>\n                        <span class=\"editorial-mono text-[10px] uppercase tracking-[.14em] text-[#9f988e]\" data-kid=\"1-2-5-1-2-2-3\" data-name=\"record field one\">\n                            Mathematics / Theater Arts\n                        </span>\n                    </div>\n                    <div class=\"group grid grid-cols-[5rem_1fr_auto] items-center gap-5 border-b hairline py-7 transition-colors hover:bg-[#24211d]\" data-kid=\"1-2-5-1-2-3\" data-name=\"lineage record row two\">\n                        <span class=\"editorial-mono text-xs text-[#b18d5b]\" data-kid=\"1-2-5-1-2-3-1\" data-name=\"record year two\">\n                            2022\n                        </span>\n                        <span class=\"editorial-serif text-3xl text-[#f3efe7]\" data-kid=\"1-2-5-1-2-3-2\" data-name=\"record name two\">\n                            Adegbenro Daniel\n                            <span class=\"text-[#807a70]\" data-kid=\"1-2-5-1-2-3-2-1\" data-name=\"record subname two\">\n                                & Onuoha Marvellous\n                            </span>\n                        </span>\n                        <span class=\"editorial-mono text-[10px] uppercase tracking-[.14em] text-[#9f988e]\" data-kid=\"1-2-5-1-2-3-3\" data-name=\"record field two\">\n                            European Studies / Special Education\n                        </span>\n                    </div>\n                    <div class=\"group grid grid-cols-[5rem_1fr_auto] items-center gap-5 py-7 transition-colors hover:bg-[#24211d]\" data-kid=\"1-2-5-1-2-4\" data-name=\"lineage record row three\">\n                        <span class=\"editorial-mono text-xs text-[#b18d5b]\" data-kid=\"1-2-5-1-2-4-1\" data-name=\"record year three\">\n                            2020\n                        </span>\n                        <span class=\"editorial-serif text-3xl text-[#f3efe7]\" data-kid=\"1-2-5-1-2-4-2\" data-name=\"record name three\">\n                            The class of 2020\n                        </span>\n                        <span class=\"editorial-mono text-[10px] uppercase tracking-[.14em] text-[#9f988e]\" data-kid=\"1-2-5-1-2-4-3\" data-name=\"record field three\">\n                            Mr & Mrs UI\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"mx-auto max-w-[1440px] px-6 py-24 lg:px-16 lg:py-36\" data-kid=\"1-2-6\" data-name=\"night invitation section\" id=\"the-night\">\n            <div class=\"mx-auto max-w-[980px] border border-[#b18d5b]/60 bg-[#181714] px-6 py-12 text-center sm:px-12 lg:px-24 lg:py-20\" data-kid=\"1-2-6-1\" data-name=\"invitation container\">\n                <p class=\"editorial-mono text-[10px] uppercase tracking-[.35em] text-[#d2b989]\" data-kid=\"1-2-6-1-1\" data-name=\"invitation label\">\n                    05 / An invitation to the night\n                </p>\n                <div class=\"mx-auto my-8 h-px w-24 bg-[#b18d5b]\" data-kid=\"1-2-6-1-2\" data-name=\"invitation separator line\">\n                </div>\n                <h2 class=\"editorial-serif text-6xl leading-[.9] text-[#f3efe7] lg:text-8xl\" data-kid=\"1-2-6-1-3\" data-name=\"invitation headline\">\n                    The Legacy\n                    <br data-kid=\"1-2-6-1-3-1\" data-name=\"invitation headline line break\">\n                    <em class=\"text-[#d2b989]\" data-kid=\"1-2-6-1-3-2\" data-name=\"invitation emphasized text\">\n                        Edition\n                    </em>\n                </h2>\n                <p class=\"mx-auto mt-8 max-w-[38rem] text-base leading-8 text-[#b9b2a6]\" data-kid=\"1-2-6-1-4\" data-name=\"invitation body text\">\n                    The 2026 edition marks 15 years of excellence, influence, elegance, and unforgettable legacy within the University of Ibadan community.\n                </p>\n                <div class=\"mx-auto mt-14 max-w-[620px] border-y hairline text-left\" data-kid=\"1-2-6-1-5\" data-name=\"event details list\">\n                    <div class=\"flex flex-wrap items-baseline justify-between gap-4 border-b hairline py-5\" data-kid=\"1-2-6-1-5-1\" data-name=\"event detail row one\">\n                        <span class=\"editorial-mono text-[9px] uppercase tracking-[.26em] text-[#807a70]\" data-kid=\"1-2-6-1-5-1-1\" data-name=\"event detail label one\">\n                            Event\n                        </span>\n                        <span class=\"editorial-serif text-2xl text-[#f3efe7]\" data-kid=\"1-2-6-1-5-1-2\" data-name=\"event detail value one\">\n                            Mr and Miss Unibadan 2026\n                        </span>\n                    </div>\n                    <div class=\"flex flex-wrap items-baseline justify-between gap-4 border-b hairline py-5\" data-kid=\"1-2-6-1-5-2\" data-name=\"event detail row two\">\n                        <span class=\"editorial-mono text-[9px] uppercase tracking-[.26em] text-[#807a70]\" data-kid=\"1-2-6-1-5-2-1\" data-name=\"event detail label two\">\n                            Venue\n                        </span>\n                        <span class=\"editorial-serif text-2xl text-[#f3efe7]\" data-kid=\"1-2-6-1-5-2-2\" data-name=\"event detail value two\">\n                            University of Ibadan, Nigeria\n                        </span>\n                    </div>\n                    <div class=\"flex flex-wrap items-baseline justify-between gap-4 py-5\" data-kid=\"1-2-6-1-5-3\" data-name=\"event detail row three\">\n                        <span class=\"editorial-mono text-[9px] uppercase tracking-[.26em] text-[#807a70]\" data-kid=\"1-2-6-1-5-3-1\" data-name=\"event detail label three\">\n                            Edition\n                        </span>\n                        <span class=\"editorial-serif text-2xl text-[#f3efe7]\" data-kid=\"1-2-6-1-5-3-2\" data-name=\"event detail value three\">\n                            2026 / Crystal Excellence\n                        </span>\n                    </div>\n                </div>\n                <a class=\"focus-ring mt-14 inline-flex items-center gap-4 bg-[#b18d5b] px-7 py-4 editorial-mono text-[10px] uppercase tracking-[.2em] text-[#10100f] transition-colors hover:bg-[#d2b989]\" data-kid=\"1-2-6-1-6\" data-name=\"invitation action button\" href=\"#hero\">\n                    Stay informed\n                    <span aria-hidden=\"true\" data-kid=\"1-2-6-1-6-1\" data-name=\"arrow icon\">\n                        ↗\n                    </span>\n                </a>\n                <p class=\"mt-10 editorial-mono text-[9px] uppercase tracking-[.2em] text-[#807a70]\" data-kid=\"1-2-6-1-7\" data-name=\"invitation footer label\">\n                    Elegance · Balance · Crown\n                </p>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t hairline bg-[#0a0a09] px-6 py-10 lg:px-16\" data-kid=\"1-3\" data-name=\"footer container\">\n        <div class=\"mx-auto flex max-w-[1440px] flex-col justify-between gap-6 sm:flex-row sm:items-end\" data-kid=\"1-3-1\" data-name=\"footer inner content\">\n            <div data-kid=\"1-3-1-1\" data-name=\"footer brand group\">\n                <p class=\"editorial-mono text-[10px] uppercase tracking-[.3em] text-[#d2b989]\" data-kid=\"1-3-1-1-1\" data-name=\"footer brand name\">\n                    Unibadan\n                </p>\n                <p class=\"mt-3 editorial-serif text-xl italic text-[#9f988e]\" data-kid=\"1-3-1-1-2\" data-name=\"footer brand motto\">\n                    Where the brilliant find their balance.\n                </p>\n            </div>\n            <p class=\"editorial-mono text-[9px] uppercase tracking-[.18em] text-[#807a70]\" data-kid=\"1-3-1-2\" data-name=\"footer copyright text\">\n                © 2026 Mr & Miss Unibadan / University of Ibadan\n            </p>\n        </div>\n    </footer>\n</div>\n",
