      },
      "html": "<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700&display=swap');\n\n  :root {\n    --black: #0d090a;\n    --black-soft: #171011;\n    --black-panel: #201516;\n    --wine-deep: #2b080d;\n    --wine: #5d1018;\n    --wine-mid: #741923;\n    --wine-bright: #8c242d;\n    --gold: #c5a15b;\n    --gold-light: #e4c47b;\n    --cream: #f2eadc;\n    --cream-soft: #d8ccbd;\n    --muted: #aa9a92;\n    --hairline: rgba(242, 234, 220, .18);\n    --hairline-dark: rgba(13, 9, 10, .18);\n  }\n\n  html { scroll-behavior: smooth; }\n  body { margin: 0; background: var(--black); color: var(--cream); font-family: 'Inter', sans-serif; }\n  a { color: inherit; text-decoration: none; }\n  button { font: inherit; }\n  .display { font-family: 'Cormorant Garamond', Georgia, serif; }\n  .mono { font-family: 'DM Mono', monospace; }\n  .hairline { border-color: var(--hairline); }\n  .focus-ring:focus-visible { outline: 2px solid var(--gold-light); outline-offset: 5px; }\n  .eyebrow { display: flex; align-items: center; gap: 12px; color: var(--gold-light); font: 10px 'DM Mono', monospace; letter-spacing: .26em; text-transform: uppercase; }\n  .eyebrow::before { content: ''; width: 38px; height: 1px; background: var(--gold); }\n  .section-title { margin: 0; font: 500 clamp(4rem, 8vw, 8.6rem)/.82 'Cormorant Garamond', Georgia, serif; letter-spacing: -.07em; }\n  .section-title em { color: var(--gold-light); font-style: italic; }\n  .nav { position: sticky; top: 0; z-index: 20; border-bottom: 1px solid var(--hairline); background: rgba(13, 9, 10, .94); backdrop-filter: blur(18px); }\n  .nav-inner { max-width: 1440px; margin: 0 auto; min-height: 76px; display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 0 56px; }\n  .brand { color: var(--gold-light); font: 11px 'DM Mono', monospace; letter-spacing: .28em; text-transform: uppercase; white-space: nowrap; }\n  .brand span { color: var(--muted); }\n  .nav-links { display: flex; align-items: center; gap: 28px; color: var(--cream-soft); font: 10px 'DM Mono', monospace; letter-spacing: .12em; text-transform: uppercase; }\n  .nav-links a { transition: color .25s ease; }\n  .nav-links a:hover { color: var(--gold-light); }\n  .nav-cta, .gold-button { display: inline-flex; align-items: center; justify-content: center; gap: 12px; border: 1px solid var(--gold); background: var(--gold); color: var(--black); padding: 14px 20px; font: 10px 'DM Mono', monospace; letter-spacing: .16em; text-transform: uppercase; transition: background .25s ease, color .25s ease, border-color .25s ease, transform .25s ease; }\n  .nav-cta:hover, .gold-button:hover { background: var(--gold-light); border-color: var(--gold-light); transform: translateY(-2px); }\n  .mobile-rail { display: none; }\n\n  .hero { position: relative; overflow: hidden; background: var(--wine); }\n  .hero::before { content: ''; position: absolute; inset: 0; opacity: .4; background-image: radial-gradient(rgba(228,196,123,.28) 1px, transparent 1px); background-size: 28px 28px; mask-image: linear-gradient(to bottom, black, transparent 92%); }\n  .hero::after { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 78% 40%, rgba(228,196,123,.18), transparent 28%), linear-gradient(90deg, rgba(43,8,13,.75), transparent 60%); pointer-events: none; }\n  .hero-inner { position: relative; z-index: 1; max-width: 1440px; margin: 0 auto; min-height: 760px; display: grid; grid-template-columns: .92fr 1.08fr; align-items: center; gap: 64px; padding: 84px 56px 74px; }\n  .hero-copy { max-width: 700px; }\n  .hero-kicker { display: inline-flex; align-items: center; gap: 10px; border: 1px solid rgba(228,196,123,.42); border-radius: 999px; padding: 9px 14px; color: var(--gold-light); font: 10px 'DM Mono', monospace; letter-spacing: .14em; text-transform: uppercase; }\n  .hero-title { margin: 36px 0 0; max-width: 760px; font: 500 clamp(5.3rem, 10vw, 10.5rem)/.78 'Cormorant Garamond', Georgia, serif; letter-spacing: -.08em; }\n  .hero-title em { display: inline-block; color: var(--gold-light); font-style: italic; }\n  .hero-lead { max-width: 510px; margin: 34px 0 0; border-left: 2px solid var(--gold); padding-left: 18px; color: var(--cream); font: 500 22px/1.35 'Cormorant Garamond', Georgia, serif; }\n  .hero-meta { display: flex; align-items: flex-end; gap: 44px; margin-top: 42px; }\n  .metric-value { color: var(--gold-light); font: 500 50px/.9 'Cormorant Garamond', Georgia, serif; }\n  .metric-label { margin-top: 8px; color: rgba(242,234,220,.66); font: 9px 'DM Mono', monospace; letter-spacing: .18em; text-transform: uppercase; }\n  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 42px; }\n  .ghost-button { display: inline-flex; align-items: center; justify-content: center; gap: 12px; border: 1px solid rgba(228,196,123,.6); background: transparent; color: var(--gold-light); padding: 14px 20px; font: 10px 'DM Mono', monospace; letter-spacing: .16em; text-transform: uppercase; transition: background .25s ease, color .25s ease; }\n  .ghost-button:hover { background: rgba(228,196,123,.12); color: var(--cream); }\n  .hero-art { position: relative; min-height: 570px; border: 1px solid rgba(228,196,123,.38); background: var(--black); overflow: hidden; }\n  .hero-art img { width: 100%; height: 100%; min-height: 570px; display: block; object-fit: cover; filter: saturate(.72) contrast(1.08) sepia(.16); }\n  .hero-art::before { content: ''; position: absolute; z-index: 1; inset: 0; background: linear-gradient(180deg, rgba(13,9,10,.08), rgba(13,9,10,.75)); pointer-events: none; }\n  .hero-caption { position: absolute; z-index: 2; inset: auto 24px 24px; display: flex; align-items: flex-end; justify-content: space-between; gap: 18px; }\n  .hero-caption p { margin: 0; }\n  .caption-label { color: var(--gold-light); font: 9px 'DM Mono', monospace; letter-spacing: .2em; text-transform: uppercase; }\n  .caption-title { margin-top: 8px !important; color: var(--cream); font: italic 28px/1 'Cormorant Garamond', Georgia, serif; }\n  .vertical-note { color: var(--gold-light); font: 9px 'DM Mono', monospace; letter-spacing: .18em; text-transform: uppercase; writing-mode: vertical-rl; transform: rotate(180deg); }\n\n  .section { max-width: 1440px; margin: 0 auto; padding: 116px 56px; }\n  .intro-section { background: var(--black); }\n  .intro-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 90px; align-items: end; }\n  .intro-copy { max-width: 720px; }\n  .intro-lead { margin: 0; color: var(--cream); font: 500 34px/1.12 'Cormorant Garamond', Georgia, serif; }\n  .intro-body { max-width: 620px; margin: 26px 0 0; color: var(--muted); font-size: 15px; line-height: 1.9; }\n  .stat-ribbon { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 46px; border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); }\n  .stat { padding: 23px 20px 24px 0; }\n  .stat + .stat { border-left: 1px solid var(--hairline); padding-left: 20px; }\n\n  .contestants-section { background: var(--cream); color: var(--black); max-width: none; }\n  .contestants-inner { max-width: 1440px; margin: 0 auto; padding: 116px 56px; }\n  .section-heading-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 30px; padding-bottom: 34px; border-bottom: 1px solid rgba(13,9,10,.2); }\n  .dark-eyebrow { color: var(--wine); }\n  .dark-eyebrow::before { background: var(--wine); }\n  .contestants-summary { max-width: 300px; margin: 0; color: #6e6260; font-size: 14px; line-height: 1.7; }\n  .contestant-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 48px; }\n  .contestant-card { position: relative; display: flex; flex-direction: column; min-height: 560px; border: 1px solid rgba(13,9,10,.16); background: #fbf7ef; overflow: hidden; transition: transform .3s ease, box-shadow .3s ease; }\n  .contestant-card:hover { transform: translateY(-6px); box-shadow: 0 24px 42px rgba(43,8,13,.14); }\n  .contestant-card:nth-child(2) { margin-top: 42px; }\n  .contestant-card:nth-child(3) { margin-top: 84px; }\n  .contestant-image-wrap { position: relative; aspect-ratio: 4 / 4.7; overflow: hidden; background: var(--black-panel); }\n  .contestant-image-wrap::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 56%, rgba(13,9,10,.45)); pointer-events: none; }\n  .contestant-image { width: 100%; height: 100%; display: block; object-fit: cover; filter: saturate(.82) contrast(1.04); transition: transform .45s ease, filter .45s ease; }\n  .contestant-card:hover .contestant-image { transform: scale(1.035); filter: saturate(1) contrast(1.06); }\n  .number-badge { position: absolute; z-index: 2; top: 16px; right: 16px; display: grid; place-items: center; width: 52px; height: 52px; border: 1px solid var(--gold-light); border-radius: 50%; background: var(--wine); color: var(--gold-light); font: 16px 'Cormorant Garamond', Georgia, serif; }\n  .contestant-info { display: flex; flex: 1; flex-direction: column; padding: 24px 24px 22px; }\n  .contestant-name { margin: 0; color: var(--wine); font: 600 28px/1 'Cormorant Garamond', Georgia, serif; }\n  .contestant-field { display: grid; gap: 7px; margin-top: 18px; color: #655958; font-size: 12px; line-height: 1.45; }\n  .contestant-quote { margin: 20px 0 0; border-left: 2px solid var(--gold); padding-left: 12px; color: #6f6560; font: italic 16px/1.4 'Cormorant Garamond', Georgia, serif; }\n  .vote-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: auto; padding-top: 24px; }\n  .vote-count { color: var(--wine); font: 500 19px 'Cormorant Garamond', Georgia, serif; }\n  .vote-button { display: inline-flex; align-items: center; justify-content: center; gap: 8px; border: 0; background: var(--wine); color: var(--cream); padding: 12px 15px; font: 10px 'DM Mono', monospace; letter-spacing: .12em; text-transform: uppercase; cursor: pointer; transition: background .25s ease, transform .25s ease; }\n  .vote-button:hover { background: var(--wine-bright); transform: translateY(-2px); }\n  .all-contestants { display: flex; justify-content: center; margin-top: 54px; }\n  .wine-outline { border-color: var(--wine); color: var(--wine); }\n  .wine-outline:hover { background: rgba(93,16,24,.08); color: var(--wine); }\n\n  .leaderboard-section { background: var(--black-soft); border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); }\n  .leaderboard-head { display: grid; grid-template-columns: .9fr 1.1fr; gap: 80px; align-items: end; }\n  .leaderboard-intro { max-width: 430px; margin: 0; color: var(--muted); font-size: 15px; line-height: 1.8; }\n  .leaderboard-list { margin-top: 54px; border-top: 1px solid var(--hairline); }\n  .leader-row { display: grid; grid-template-columns: 70px 70px 1fr auto; gap: 18px; align-items: center; padding: 18px 0; border-bottom: 1px solid var(--hairline); }\n  .leader-row:first-child { border-color: rgba(228,196,123,.55); background: rgba(93,16,24,.34); }\n  .leader-rank { color: var(--gold-light); font: 42px/1 'Cormorant Garamond', Georgia, serif; }\n  .leader-thumb { width: 56px; height: 56px; border: 1px solid var(--gold); border-radius: 50%; object-fit: cover; }\n  .leader-name { color: var(--cream); font: 500 27px/1 'Cormorant Garamond', Georgia, serif; }\n  .leader-sub { margin-top: 7px; color: var(--muted); font: 10px 'DM Mono', monospace; letter-spacing: .04em; }\n  .leader-votes { color: var(--gold-light); font: 500 28px/1 'Cormorant Garamond', Georgia, serif; text-align: right; }\n  .leader-votes span { display: block; margin-top: 6px; color: var(--muted); font: 9px 'DM Mono', monospace; letter-spacing: .17em; text-transform: uppercase; }\n\n  .about-section { background: var(--cream); color: var(--black); max-width: none; }\n  .about-inner { max-width: 1440px; margin: 0 auto; padding: 116px 56px; }\n  .about-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 90px; align-items: start; }\n  .about-title { color: var(--black); }\n  .about-title em { color: var(--wine); }\n  .about-copy { max-width: 650px; color: #655958; font-size: 16px; line-height: 1.85; }\n  .pillars { display: grid; gap: 12px; margin-top: 38px; }\n  .pillar { display: flex; align-items: center; justify-content: space-between; gap: 18px; border: 1px solid rgba(13,9,10,.15); padding: 22px 24px; background: rgba(255,255,255,.32); }\n  .pillar h3 { margin: 0; color: var(--wine); font: 500 28px/1 'Cormorant Garamond', Georgia, serif; }\n  .pillar p { margin: 0; color: #6e6260; font-size: 13px; text-align: right; }\n\n  .footer { background: var(--wine-deep); border-top: 1px solid rgba(228,196,123,.28); }\n  .footer-inner { max-width: 1440px; margin: 0 auto; padding: 70px 56px 26px; }\n  .footer-grid { display: grid; grid-template-columns: 1.2fr .8fr .8fr; gap: 60px; padding-bottom: 62px; }\n  .footer-brand { max-width: 330px; }\n  .footer-brand .brand { display: block; margin-bottom: 18px; }\n  .footer-tagline { margin: 0; color: var(--cream-soft); font: italic 25px/1.15 'Cormorant Garamond', Georgia, serif; }\n  .footer-copy { margin: 18px 0 0; color: rgba(242,234,220,.68); font-size: 13px; line-height: 1.7; }\n  .footer-title { margin: 0 0 18px; color: var(--gold-light); font: 500 18px 'Cormorant Garamond', Georgia, serif; text-transform: uppercase; letter-spacing: .08em; }\n  .footer-links { display: grid; gap: 12px; color: var(--cream-soft); font-size: 13px; }\n  .footer-links a:hover { color: var(--gold-light); }\n  .footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 20px; border-top: 1px solid rgba(242,234,220,.15); padding-top: 22px; color: rgba(242,234,220,.52); font: 9px 'DM Mono', monospace; letter-spacing: .14em; text-transform: uppercase; }\n\n  @media (max-width: 920px) {\n    .nav-inner { padding: 0 24px; }\n    .nav-links, .nav-cta { display: none; }\n    .mobile-rail { display: flex; gap: 24px; overflow-x: auto; border-top: 1px solid var(--hairline); padding: 12px 24px; color: var(--cream-soft); font: 9px 'DM Mono', monospace; letter-spacing: .14em; text-transform: uppercase; scrollbar-width: none; }\n    .mobile-rail a { flex-shrink: 0; }\n    .hero-inner, .intro-grid, .leaderboard-head, .about-grid { grid-template-columns: 1fr; }\n    .hero-inner { padding: 68px 24px 54px; }\n    .hero-copy { order: 1; }\n    .hero-art { order: 0; min-height: 430px; }\n    .hero-art img { min-height: 430px; }\n    .section, .contestants-inner, .about-inner { padding: 86px 24px; }\n    .intro-grid, .about-grid { gap: 50px; }\n    .contestant-grid { grid-template-columns: repeat(2, 1fr); }\n    .contestant-card:nth-child(2), .contestant-card:nth-child(3) { margin-top: 0; }\n    .footer-inner { padding: 60px 24px 22px; }\n    .footer-grid { grid-template-columns: 1fr 1fr; }\n  }\n  @media (max-width: 580px) {\n    .brand { font-size: 9px; letter-spacing: .18em; }\n    .hero-title { font-size: clamp(4.3rem, 20vw, 6rem); }\n    .hero-lead { font-size: 20px; }\n    .hero-meta { gap: 26px; }\n    .hero-actions { align-items: stretch; flex-direction: column; }\n    .hero-actions a { width: 100%; }\n    .section-title { font-size: clamp(4rem, 18vw, 6rem); }\n    .section-heading-row { align-items: flex-start; flex-direction: column; }\n    .stat-ribbon { grid-template-columns: 1fr; }\n    .stat, .stat + .stat { border-left: 0; padding-left: 0; }\n    .stat + .stat { border-top: 1px solid var(--hairline); }\n    .contestant-grid { grid-template-columns: 1fr; }\n    .contestant-card { min-height: 0; }\n    .leader-row { grid-template-columns: 42px 48px 1fr; gap: 10px; }\n    .leader-rank { font-size: 31px; }\n    .leader-thumb { width: 42px; height: 42px; }\n    .leader-name { font-size: 21px; }\n    .leader-sub { font-size: 8px; line-height: 1.35; }\n    .leader-votes { grid-column: 3; text-align: left; font-size: 21px; }\n    .about-grid { gap: 38px; }\n    .pillar { align-items: flex-start; flex-direction: column; }\n    .pillar p { text-align: left; }\n    .footer-grid { grid-template-columns: 1fr; gap: 36px; }\n    .footer-bottom { align-items: flex-start; flex-direction: column; }\n    .night-panel { grid-template-columns: 1fr !important; }\n    .night-image, .night-image img { min-height: 360px !important; }\n    .night-details { padding: 42px 24px !important; }\n    .night-details .detail-row { align-items: flex-start !important; flex-direction: column; gap: 8px !important; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    html { scroll-behavior: auto; }\n    *, *::before, *::after { transition-duration: .01ms !important; animation-duration: .01ms !important; }\n  }\n</style>\n<div data-kid=\"1\" id=\"top\" style=\"background:var(--black); color:var(--cream);\">\n    <header class=\"nav\" data-kid=\"1-1\">\n        <div class=\"nav-inner\" data-kid=\"1-1-1\">\n            <a class=\"brand focus-ring\" data-kid=\"1-1-1-1\" href=\"#top\">\n                Mr & Miss UI\n                <span data-kid=\"1-1-1-1-1\">\n                    / 2026\n                </span>\n            </a>\n            <nav aria-label=\"Primary navigation\" class=\"nav-links\" data-kid=\"1-1-1-2\">\n                <a class=\"focus-ring\" data-kid=\"1-1-1-2-1\" href=\"#contestants\">\n                    Contestants\n                </a>\n                <a class=\"focus-ring\" data-kid=\"1-1-1-2-2\" href=\"#leaderboard\">\n                    Leaderboard\n                </a>\n                <a class=\"focus-ring\" data-kid=\"1-1-1-2-3\" href=\"#about\">\n                    About\n                </a>\n                <a class=\"focus-ring\" data-kid=\"1-1-1-2-4\" href=\"#the-night\">\n                    The Night\n                </a>\n            </nav>\n            <a class=\"nav-cta focus-ring\" data-kid=\"1-1-1-3\" href=\"#contestants\">\n                Vote now\n                <span aria-hidden=\"true\" data-kid=\"1-1-1-3-1\">\n                    ↘\n                </span>\n            </a>\n        </div>\n        <nav aria-label=\"Mobile navigation\" class=\"mobile-rail\" data-kid=\"1-1-2\">\n            <a class=\"focus-ring\" data-kid=\"1-1-2-1\" href=\"#contestants\">\n                Contestants\n            </a>\n            <a class=\"focus-ring\" data-kid=\"1-1-2-2\" href=\"#leaderboard\">\n                Leaderboard\n            </a>\n            <a class=\"focus-ring\" data-kid=\"1-1-2-3\" href=\"#about\">\n                About\n            </a>\n            <a class=\"focus-ring\" data-kid=\"1-1-2-4\" href=\"#the-night\">\n                The Night\n            </a>\n        </nav>\n    </header>\n    <main data-kid=\"1-2\">\n        <section class=\"hero\" data-kid=\"1-2-1\" id=\"hero\">\n            <div class=\"hero-inner\" data-kid=\"1-2-1-1\">\n                <div class=\"hero-copy\" data-kid=\"1-2-1-1-1\">\n                    <span class=\"hero-kicker\" data-kid=\"1-2-1-1-1-1\">\n                        People's choice · voting edition\n                    </span>\n                    <h1 class=\"hero-title\" data-kid=\"1-2-1-1-1-2\">\n                        Mr &\n                        <br data-kid=\"1-2-1-1-1-2-1\" data-name=\"hero title break\">\n                        <em data-kid=\"1-2-1-1-1-2-2\">\n                            Miss\n                        </em>\n                        <br data-kid=\"1-2-1-1-1-2-3\" data-name=\"hero title second break\">\n                        Unibadan.\n                    </h1>\n                    <p class=\"hero-lead\" data-kid=\"1-2-1-1-1-3\">\n                        Where brilliance meets grace — cast your vote for the students carrying the identity of UI forward.\n                    </p>\n                    <div aria-label=\"Voting information\" class=\"hero-meta\" data-kid=\"1-2-1-1-1-4\" data-name=\"voting information metrics container\">\n                        <div data-kid=\"1-2-1-1-1-4-1\" data-name=\"contestants metric container\">\n                            <div class=\"metric-value\" data-kid=\"1-2-1-1-1-4-1-1\" data-name=\"contestants metric value\">\n                                21\n                            </div>\n                            <div class=\"metric-label\" data-kid=\"1-2-1-1-1-4-1-2\" data-name=\"contestants metric label\">\n                                Contestants\n                            </div>\n                        </div>\n                        <div data-kid=\"1-2-1-1-1-4-2\" data-name=\"days left metric container\">\n                            <div class=\"metric-value\" data-kid=\"1-2-1-1-1-4-2-1\" data-name=\"days left metric value\">\n                                15\n                            </div>\n                            <div class=\"metric-label\" data-kid=\"1-2-1-1-1-4-2-2\" data-name=\"days left metric label\">\n                                Days left\n                            </div>\n                        </div>\n                        <div data-kid=\"1-2-1-1-1-4-3\" data-name=\"crown night metric container\">\n                            <div class=\"metric-value\" data-kid=\"1-2-1-1-1-4-3-1\" data-name=\"crown night metric value\">\n                                01\n                            </div>\n                            <div class=\"metric-label\" data-kid=\"1-2-1-1-1-4-3-2\" data-name=\"crown night metric label\">\n                                Crown night\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"hero-actions\" data-kid=\"1-2-1-1-1-5\">\n                        <a class=\"gold-button focus-ring\" data-kid=\"1-2-1-1-1-5-1\" href=\"#contestants\">\n                            Meet the contestants\n                            <span aria-hidden=\"true\" data-kid=\"1-2-1-1-1-5-1-1\">\n                                ↘\n                            </span>\n                        </a>\n                        <a class=\"ghost-button focus-ring\" data-kid=\"1-2-1-1-1-5-2\" href=\"#leaderboard\">\n                            View live votes\n                            <span aria-hidden=\"true\" data-kid=\"1-2-1-1-1-5-2-1\">\n                                ↗\n                            </span>\n                        </a>\n                    </div>\n                </div>\n                <div class=\"hero-art\" data-kid=\"1-2-1-1-2\">\n                    <img alt=\"Mr and Miss Unibadan stage and crown night poster\" data-kid=\"1-2-1-1-2-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/Images-Carousels/IMG_4695.PNG\">\n                    <div class=\"hero-caption\" data-kid=\"1-2-1-1-2-2\">\n                        <div data-kid=\"1-2-1-1-2-2-1\">\n                            <p class=\"caption-label\" data-kid=\"1-2-1-1-2-2-1-1\">\n                                A ceremony of becoming\n                            </p>\n                            <p class=\"caption-title\" data-kid=\"1-2-1-1-2-2-1-2\">\n                                Vote for the story you believe in.\n                            </p>\n                        </div>\n                        <span class=\"vertical-note\" data-kid=\"1-2-1-1-2-2-2\">\n                            Edition 01 / 2026\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"section intro-section\" data-kid=\"1-2-2\" id=\"calling\">\n            <div class=\"intro-grid\" data-kid=\"1-2-2-1\">\n                <div data-kid=\"1-2-2-1-1\">\n                    <p class=\"eyebrow\" data-kid=\"1-2-2-1-1-1\">\n                        01 / The calling\n                    </p>\n                    <h2 class=\"section-title\" data-kid=\"1-2-2-1-1-2\" style=\"margin-top:34px;\">\n                        A platform\n                        <br data-kid=\"1-2-2-1-1-2-1\" data-name=\"intro title break\">\n                        <em data-kid=\"1-2-2-1-1-2-2\">\n                            with purpose.\n                        </em>\n                    </h2>\n                </div>\n                <div class=\"intro-copy\" data-kid=\"1-2-2-1-2\">\n                    <p class=\"intro-lead\" data-kid=\"1-2-2-1-2-1\">\n                        For over 15 years, Mr. & Miss UI has stood as one of the most celebrated pageantry platforms within the University of Ibadan community.\n                    </p>\n                    <p class=\"intro-body\" data-kid=\"1-2-2-1-2-2\">\n                        More than a beauty pageant, it is a platform for discovering students who embody excellence, confidence, intelligence, creativity, leadership, and social influence. Your vote gives that story a visible place.\n                    </p>\n                    <div class=\"stat-ribbon\" data-kid=\"1-2-2-1-2-3\">\n                        <div class=\"stat\" data-kid=\"1-2-2-1-2-3-1\">\n                            <div class=\"metric-value\" data-kid=\"1-2-2-1-2-3-1-1\">\n                                01\n                            </div>\n                            <div class=\"metric-label\" data-kid=\"1-2-2-1-2-3-1-2\">\n                                University\n                            </div>\n                        </div>\n                        <div class=\"stat\" data-kid=\"1-2-2-1-2-3-2\">\n                            <div class=\"metric-value\" data-kid=\"1-2-2-1-2-3-2-1\">\n                                03\n                            </div>\n                            <div class=\"metric-label\" data-kid=\"1-2-2-1-2-3-2-2\">\n                                Crowns\n                            </div>\n                        </div>\n                        <div class=\"stat\" data-kid=\"1-