<span class=\"leader-rank\" data-kid=\"1-2-4-2-3-1\">\n                        #3\n                    </span>\n                    <img alt=\"Anthony Jasper Laris thumbnail\" class=\"leader-thumb\" data-kid=\"1-2-4-2-3-2\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/Images-Carousels/IMG_4793.PNG\">\n                    <div data-kid=\"1-2-4-2-3-3\">\n                        <div class=\"leader-name\" data-kid=\"1-2-4-2-3-3-1\">\n                            Anthony Jasper Laris\n                        </div>\n                        <div class=\"leader-sub\" data-kid=\"1-2-4-2-3-3-2\">\n                            Mathematics · University of Ibadan\n                        </div>\n                    </div>\n                    <div class=\"leader-votes\" data-kid=\"1-2-4-2-3-4\" data-name=\"leaderboard row 3 vote count\">\n                        5,533\n                        <span data-kid=\"1-2-4-2-3-4-1\">\n                            votes\n                        </span>\n                    </div>\n                </div>\n                <div class=\"leader-row\" data-kid=\"1-2-4-2-4\">\n                    <span class=\"leader-rank\" data-kid=\"1-2-4-2-4-1\">\n                        #4\n                    </span>\n                    <img alt=\"Tobiloba Oluwole thumbnail\" class=\"leader-thumb\" data-kid=\"1-2-4-2-4-2\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/Images-Carousels/image7.png\">\n                    <div data-kid=\"1-2-4-2-4-3\">\n                        <div class=\"leader-name\" data-kid=\"1-2-4-2-4-3-1\">\n                            Tobiloba Oluwole\n                        </div>\n                        <div class=\"leader-sub\" data-kid=\"1-2-4-2-4-3-2\">\n                            Theater Arts · University of Ibadan\n                        </div>\n                    </div>\n                    <div class=\"leader-votes\" data-kid=\"1-2-4-2-4-4\" data-name=\"leaderboard row 4 vote count\">\n                        3,448\n                        <span data-kid=\"1-2-4-2-4-4-1\">\n                            votes\n                        </span>\n                    </div>\n                </div>\n                <div class=\"leader-row\" data-kid=\"1-2-4-2-5\">\n                    <span class=\"leader-rank\" data-kid=\"1-2-4-2-5-1\">\n                        #5\n                    </span>\n                    <img alt=\"Onuoha Marvellous thumbnail\" class=\"leader-thumb\" data-kid=\"1-2-4-2-5-2\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/Images-Carousels/IMG_4752.PNG\">\n                    <div data-kid=\"1-2-4-2-5-3\">\n                        <div class=\"leader-name\" data-kid=\"1-2-4-2-5-3-1\">\n                            Onuoha Marvellous\n                        </div>\n                        <div class=\"leader-sub\" data-kid=\"1-2-4-2-5-3-2\">\n                            Special Education · University of Ibadan\n                        </div>\n                    </div>\n                    <div class=\"leader-votes\" data-kid=\"1-2-4-2-5-4\" data-name=\"leaderboard row 5 vote count\">\n                        3,210\n                        <span data-kid=\"1-2-4-2-5-4-1\">\n                            votes\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"about-section\" data-kid=\"1-2-5\" id=\"about\">\n            <div class=\"about-inner\" data-kid=\"1-2-5-1\">\n                <div class=\"about-grid\" data-kid=\"1-2-5-1-1\">\n                    <div data-kid=\"1-2-5-1-1-1\">\n                        <p class=\"eyebrow dark-eyebrow\" data-kid=\"1-2-5-1-1-1-1\">\n                            04 / The platform\n                        </p>\n                        <h2 class=\"section-title about-title\" data-kid=\"1-2-5-1-1-1-2\" style=\"margin-top:32px;\">\n                            Beyond\n                            <br data-kid=\"1-2-5-1-1-1-2-1\" data-name=\"about title break\">\n                            <em data-kid=\"1-2-5-1-1-1-2-2\">\n                                the crown.\n                            </em>\n                        </h2>\n                    </div>\n                    <div data-kid=\"1-2-5-1-1-2\">\n                        <p class=\"about-copy\" data-kid=\"1-2-5-1-1-2-1\">\n                            Mr & Miss Unibadan is a ceremonial platform for students who carry excellence beyond the stage. It celebrates confidence, creativity, leadership, and the responsibility of representing the University of Ibadan with distinction.\n                        </p>\n                        <div class=\"pillars\" data-kid=\"1-2-5-1-1-2-2\">\n                            <div class=\"pillar\" data-kid=\"1-2-5-1-1-2-2-1\">\n                                <h3 data-kid=\"1-2-5-1-1-2-2-1-1\">\n                                    Advocacy\n                                </h3>\n                                <p data-kid=\"1-2-5-1-1-2-2-1-2\">\n                                    Raising voices for causes that matter.\n                                </p>\n                            </div>\n                            <div class=\"pillar\" data-kid=\"1-2-5-1-1-2-2-2\">\n                                <h3 data-kid=\"1-2-5-1-1-2-2-2-1\">\n                                    Leadership\n                                </h3>\n                                <p data-kid=\"1-2-5-1-1-2-2-2-2\">\n                                    Shaping the next generation of UI leaders.\n                                </p>\n                            </div>\n                            <div class=\"pillar\" data-kid=\"1-2-5-1-1-2-2-3\">\n                                <h3 data-kid=\"1-2-5-1-1-2-2-3-1\">\n                                    Legacy\n                                </h3>\n                                <p data-kid=\"1-2-5-1-1-2-2-3-2\">\n                                    Building a lasting impact beyond the crown.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"section\" data-kid=\"1-2-6\" id=\"the-night\" style=\"background:var(--black);\">\n            <div class=\"night-panel\" data-kid=\"1-2-6-1\" data-name=\"grand night content container\" style=\"display:grid;grid-template-columns:.86fr 1.14fr;gap:56px;align-items:center;border:1px solid rgba(197,161,91,.62);background:var(--black-panel);padding:0;overflow:hidden;\">\n                <div class=\"night-image\" data-kid=\"1-2-6-1-1\" data-name=\"grand night image wrapper\" style=\"position:relative;min-height:500px;overflow:hidden;\">\n                    <img alt=\"Stage curtains prepared for the Mr and Miss Unibadan grand night\" data-kid=\"1-2-6-1-1-1\" data-name=\"grand night image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/image0.jpeg\" style=\"width:100%;height:100%;min-height:500px;display:block;object-fit:cover;filter:saturate(.68) sepia(.15) contrast(1.08);\">\n                    <div data-kid=\"1-2-6-1-1-2\" style=\"position:absolute;inset:0;background:linear-gradient(180deg,rgba(13,9,10,.06),rgba(13,9,10,.62));\">\n                    </div>\n                    <p class=\"mono\" data-kid=\"1-2-6-1-1-3\" style=\"position:absolute;left:24px;bottom:22px;margin:0;color:var(--gold-light);font-size:9px;letter-spacing:.18em;text-transform:uppercase;\">\n                        05 / An invitation to the night\n                    </p>\n                </div>\n                <div class=\"night-details\" data-kid=\"1-2-6-1-2\" data-name=\"grand night text details container\" style=\"padding:54px 58px;\">\n                    <p class=\"eyebrow\" data-kid=\"1-2-6-1-2-1\">\n                        The legacy edition\n                    </p>\n                    <h2 class=\"section-title\" data-kid=\"1-2-6-1-2-2\" style=\"margin-top:30px;font-size:clamp(4rem,6vw,7rem);\">\n                        The Grand\n                        <br data-kid=\"1-2-6-1-2-2-1\" data-name=\"grand night title break\">\n                        <em data-kid=\"1-2-6-1-2-2-2\">\n                            Night.\n                        </em>\n                    </h2>\n                    <p data-kid=\"1-2-6-1-2-3\" style=\"max-width:520px;margin:28px 0 0;color:var(--cream-soft);font-size:15px;line-height:1.8;\">\n                        The 2026 edition marks another chapter of excellence, influence, elegance, and unforgettable legacy within the University of Ibadan community.\n                    </p>\n                    <div data-kid=\"1-2-6-1-2-4\" style=\"margin-top:34px;border-top:1px solid var(--hairline);border-bottom:1px solid var(--hairline);\">\n                        <div class=\"detail-row\" data-kid=\"1-2-6-1-2-4-1\" data-name=\"grand night event detail row\" style=\"display:flex;justify-content:space-between;gap:20px;padding:17px 0;border-bottom:1px solid var(--hairline);\">\n                            <span class=\"mono\" data-kid=\"1-2-6-1-2-4-1-1\" style=\"color:var(--muted);font-size:9px;letter-spacing:.18em;text-transform:uppercase;\">\n                                Event\n                            </span>\n                            <span class=\"display\" data-kid=\"1-2-6-1-2-4-1-2\" style=\"font-size:22px;\">\n                                Mr & Miss Unibadan 2026\n                            </span>\n                        </div>\n                        <div class=\"detail-row\" data-kid=\"1-2-6-1-2-4-2\" data-name=\"grand night venue info row\" style=\"display:flex;justify-content:space-between;gap:20px;padding:17px 0;border-bottom:1px solid var(--hairline);\">\n                            <span class=\"mono\" data-kid=\"1-2-6-1-2-4-2-1\" style=\"color:var(--muted);font-size:9px;letter-spacing:.18em;text-transform:uppercase;\">\n                                Venue\n                            </span>\n                            <span class=\"display\" data-kid=\"1-2-6-1-2-4-2-2\" style=\"font-size:22px;\">\n                                University of Ibadan\n                            </span>\n                        </div>\n                        <div class=\"detail-row\" data-kid=\"1-2-6-1-2-4-3\" data-name=\"grand night info row edition\" style=\"display:flex;justify-content:space-between;gap:20px;padding:17px 0;\">\n                            <span class=\"mono\" data-kid=\"1-2-6-1-2-4-3-1\" style=\"color:var(--muted);font-size:9px;letter-spacing:.18em;text-transform:uppercase;\">\n                                Edition\n                            </span>\n                            <span class=\"display\" data-kid=\"1-2-6-1-2-4-3-2\" style=\"font-size:22px;\">\n                                2026 / Crystal Excellence\n                            </span>\n                        </div>\n                    </div>\n                    <a class=\"gold-button focus-ring\" data-kid=\"1-2-6-1-2-5\" href=\"#top\" style=\"margin-top:34px;\">\n                        Stay informed\n                        <span aria-hidden=\"true\" data-kid=\"1-2-6-1-2-5-1\">\n                            ↗\n                        </span>\n                    </a>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"footer\" data-kid=\"1-3\">\n        <div class=\"footer-inner\" data-kid=\"1-3-1\">\n            <div class=\"footer-grid\" data-kid=\"1-3-1-1\">\n                <div class=\"footer-brand\" data-kid=\"1-3-1-1-1\">\n                    <span class=\"brand\" data-kid=\"1-3-1-1-1-1\">\n                        Unibadan\n                        <span data-kid=\"1-3-1-1-1-1-1\">\n                            / 2026\n                        </span>\n                    </span>\n                    <p class=\"footer-tagline\" data-kid=\"1-3-1-1-1-2\">\n                        Where the brilliant find their balance.\n                    </p>\n                    <p class=\"footer-copy\" data-kid=\"1-3-1-1-1-3\">\n                        A ceremonial voting platform for the students carrying the identity and excellence of UI forward.\n                    </p>\n                </div>\n                <div data-kid=\"1-3-1-1-2\">\n                    <h3 class=\"footer-title\" data-kid=\"1-3-1-1-2-1\">\n                        Explore\n                    </h3>\n                    <div class=\"footer-links\" data-kid=\"1-3-1-1-2-2\">\n                        <a data-kid=\"1-3-1-1-2-2-1\" href=\"#contestants\">\n                            Contestants\n                        </a>\n                        <a data-kid=\"1-3-1-1-2-2-2\" href=\"#leaderboard\">\n                            Leaderboard\n                        </a>\n                        <a data-kid=\"1-3-1-1-2-2-3\" href=\"#about\">\n                            About the platform\n                        </a>\n                        <a data-kid=\"1-3-1-1-2-2-4\" href=\"#the-night\">\n                            The Grand Night\n                        </a>\n                    </div>\n                </div>\n                <div data-kid=\"1-3-1-1-3\">\n                    <h3 class=\"footer-title\" data-kid=\"1-3-1-1-3-1\">\n                        Contact\n                    </h3>\n                    <div class=\"footer-links\" data-kid=\"1-3-1-1-3-2\">\n                        <a data-kid=\"1-3-1-1-3-2-1\" href=\"#top\">\n                            Instagram / @mrandmissui\n                        </a>\n                        <a data-kid=\"1-3-1-1-3-2-2\" href=\"#top\">\n                            University of Ibadan, Nigeria\n                        </a>\n                        <a data-kid=\"1-3-1-1-3-2-3\" href=\"#top\">\n                            Get in touch ↗\n                        </a>\n          